# env.example — только ИМЕНА переменных окружения, значений здесь нет.
# Секреты задаются только в окружении сервера (не в коде, не в репозитории).
# Скопируйте в .env (он в .gitignore) и заполните локально.

# Единый пароль демо-аккаунтов (публикуется в комментарии к работе, не в репо)
PARA_DEMO_PASSWORD=

# Соль/секрет для подписи cookie сессий (случайный 128-бит+, генерируется на сервере)
PARA_SESSION_SECRET=

# Путь к базе SQLite (по умолчанию data/para.db)
PARA_DB_PATH=
