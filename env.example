# env.example — только ИМЕНА переменных окружения, значений здесь нет.
# Секреты задаются только в окружении сервера (не в коде, не в репозитории).
# Скопируйте в .env (он в .gitignore) и заполните локально.

# Единый пароль демо-аккаунтов (шаг 6/Э10). Приложение его НЕ читает —
# в БД только argon2id-хэши; нужен утилитам генерации хэшей и команде
# для публикации в комментарии к работе (AGENTS.md §5.2, §8)
PARA_DEMO_PASSWORD=

# Время жизни сессии в часах (по умолчанию 720 = 30 суток — с запасом до
# итогов 28.11; читается main.cpp, шаг 7 Э1)
PARA_SESSION_TTL_HOURS=

# Путь к базе SQLite (по умолчанию /opt/para/data/para.db — config.json).
# Читает main.cpp при старте (Э8 шаг 6, 02 §6.5): переопределяет ОДНОВРЕМЕННО
# custom_config.db_path (миграционный раннер) и db_clients[*].filename (пул
# Drogon) — двух разных файлов не бывает. Демо-контур docker compose
# пробрасывает .env в контейнер (env_file, опциональный).
PARA_DB_PATH=

# Примечание (шаг 7, 02 §6.1): сессии — собственная таблица sessions со
# случайным 128-бит токеном в cookie; подписи cookie нет, отдельный
# «ключ сессий» (PARA_SESSION_SECRET прежних редакций) не требуется.

