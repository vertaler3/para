/* «Пара» — конфиг каркаса Э1 (шаги 2 и 4): без секретов (AGENTS.md §5.2).
   Секреты и ключи — только в переменных окружения сервера (см. env.example).
   Сессии и фильтры добавляются на шагах 5–7 Э1. */
{
    "listeners": [
        {
            //address: Ip address, 0.0.0.0 by default
            "address": "0.0.0.0",
            //port: Port number
            "port": 8080,
            //https: TLS терминируется на Nginx (02 §7.1), здесь — false
            "https": false
        }
    ],
    "app": {
        //number_of_threads: количество IO-потоков
        "number_of_threads": 1,
        //enable_session: сессии включаются на шаге 7 Э1 (AuthCtrl + LoginFilter)
        "enable_session": false,
        //upload_path: временные загрузки Drogon — на томе para-data (владелец
        //UID 10001); дефолт "uploads" в /opt/para недоступен на запись (Р-4 п.7)
        "upload_path": "data/uploads",
        //document_root: корень статики (наполнение — FE-дорожка, Э3–Э4)
        "document_root": "./",
        //log: вывод в stdout — Docker собирает логи движком; логи без паролей/токенов (02 §6.5)
        "log": {
            "use_spdlog": false,
            "logfile_base_name": "",
            "log_size_limit": 100000000,
            "max_files": 0,
            "log_level": "INFO",
            "display_local_time": true
        }
    },
    //db_clients: SQLite DbClient — пул для сервисов (02 §2.2, §3, §7.5).
    //filename — файл БД внутри контейнера, на именованном томе para-data
    //(Dockerfile: /opt/para/data). initialization_queries выполняются на
    //каждом соединении (Drogon 1.9.14): WAL + synchronous=NORMAL (02 §7.5).
    "db_clients": [
        {
            "name": "para",
            "rdbms": "sqlite3",
            "filename": "/opt/para/data/para.db",
            "connection_number": 1,
            "initialization_queries": [
                "PRAGMA journal_mode=WAL;",
                "PRAGMA synchronous=NORMAL;"
            ]
        }
    ],
    //custom_config: параметры миграционного раннера (main.cpp, 02 §8.3;
    //docs/decisions.md Р-5). db_path ОБЯЗАН совпадать с db_clients[para].
    //filename — это один и тот же файл БД; менять только вместе.
    //migrations_dir/fixtures_path — относительно WORKDIR (/opt/para в
    //контейнере, корень проекта при локальном запуске).
    "custom_config": {
        "db_path": "/opt/para/data/para.db",
        "migrations_dir": "sql/migrations",
        "fixtures_path": "sql/fixtures.sql"
    }
}
