<%inc
#include <json/json.h>
#include <memory>
#include <string>
#include <utility>
%>
<%c++
/* Мои заявки (Э7, экран «Заявки» 1 из 4; 03 §4.5.1, design-drafts/
   applications.html и applications-states.html). Полная страница SSR:
   partials каркаса; pageTitle/activeTab — view-переменные
   ApplicationsCtrl::listPage (серверные константы, 02 §6.4). Тело —
   ApplicationsService::list (ТОТ ЖЕ метод, что стоит за JSON
   GET /v1/applications; SQL в шаблоне нет — AGENTS §5.5), приходит
   сериализованной строкой bodyJson; разбор здесь, пользовательские
   строки (названия типов) выводит HttpViewData::htmlTranslate при
   выводе (02 §6.4, Р-16: автоэкранирования в csp v1.9.14 нет).
   Фильтр ?status= — чипы-ссылки; активный — aria-current (03 §4.6:
   «активный чип — primary-soft», .chip[aria-current] — app.css);
   неизвестное значение контроллер сбрасывает 303 на /applications
   (решение в шапке ApplicationsCtrl.h). Значения словаря — CHECK DDL
   (models/Applications.h, kApplicationStatuses).
   Бейджи статусов (03 §4.5.1): активные (submitted/accepted/
   in_progress) — info, вопрос деканата (need_info) — warn, готовые
   (ready/issued) — success, терминальные (rejected/cancelled) —
   danger, черновик — outline; метки — слова таймлайна 01 §4.4
   («подана → принята → в работе → готова → выдана», С7.5).
   mini-progress — 5 стадий канонического пути заявки; заполнение —
   по ТЕКУЩЕМУ статусу (истории переходов в теле списка НЕТ, честно):
   submitted 1, accepted 2, in_progress|need_info 3, ready 4, issued 5;
   draft и терминальные — без заполнения (путь не начат/прерван, смысл
   несёт текст бейджа — цвет не единственный носитель смысла, 03 §6.4).
   Карточка списка ЦЕЛИКОМ — ссылка /applications/{id} (03 §6.2: «в
   списках весь ряд карточки кликабелен»).
   Состояния (03 §5):
     data  — есть заявки: контейнер #applications-root
             data-state="data" (смок состояния, как #grades-root);
     empty — заявок нет: «Заявок пока нет» + текст + действие
             «Открыть каталог» — финальные тексты 03 §5.2:997,
             data-state="empty";
     error — сбой БД (failed=1 от контроллера) или разбора тела:
             «Не получилось загрузить заявки» с «Повторить»
             ([data-applications-retry] — app.js, перезагрузка
             страницы) — вне data-state-контейнера, чтобы тот сохранял
             значения data|empty (прецедент grades.csp);
     скелетон — НЕ рендерится: страница целиком SSR, догрузки на
             клиенте нет (03 §5.1:984 «скелетон при догрузке»;
             прецедент grades.csp) — скелетон списков экрана заявок
             живёт на /applications/new, где каталог типов грузится
             fetch-ом;
     офлайн — баннер каркаса (topbar + app.js applyOffline, 03 §5.4).
   v3 (fe_rebuild шаг 12, applications.html + applications-states.html):
   body.document-flow (правила листа эталона), .section-title «История
   обращений» с CTA, .collection-toolbar (поиск по названию и витринному
   номеру + select групп статусов), collection-count с plural (aria-live),
   filtered-empty со «Сбросить фильтры». Сервис отдаёт ПОЛНЫЙ список;
   ?status=<группа> (контроллер) предвыбирает select и скрывает лишние
   карточки уже на SSR, дальше фильтрует app.js. Группы (каждый статус —
   ровно в одной): active = submitted|accepted|in_progress, reply =
   need_info, ready, issued, draft, closed = rejected|cancelled.
   Витринный номер «З-2026-0001» = префикс apps.numberPrefix + год
   created_at + id с нулями до 4 знаков (источником истины не является —
   поля номера в API нет; та же формула в application.csp и app.js).
   PDF-кнопки в списке нет (03 §4.5.1 черновик показывал её в карточке
   «готова») — скачивание живёт в карточке заявки (роут
   /v1/applications/{id}/pdf, обработка 409 not_ready — app.js). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js — сама страница
     (defer, локальный путь — AGENTS: без npm/CDN). -->
<script defer src="/static/js/app.js"></script>
<body class="document-flow" data-page="applications">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <h1><%c++ $$ << @@.get<std::string>("t.apps.title"); %></h1>
      <p><%c++ $$ << @@.get<std::string>("t.apps.subtitle"); %></p>
    </div>
  </div>
<%c++
const std::string failed = @@.get<std::string>("failed");
// 5.18 (шаг 3): строки — словарь t.<key> из view-данных (Р-16); lang —
// ветка локального формата дат (zh: «11月2日»).
const std::string uiLang = @@.get<std::string>("lang");
const auto vstr = [&](const char* key) {
    return @@.get<std::string>(std::string("t.") + key);
};
if (failed == "1") {
%>
  <!-- Состояние «Ошибка» (03 §5.3): «Повторить» реально перезапрашивает —
       перезагрузка страницы (app.js, [data-applications-retry]). -->
  <div class="content-narrow">
    <div class="section-title"><h2><%c++ $$ << @@.get<std::string>("t.apps.history"); %></h2><a class="button primary" href="/applications/new"><%c++ $$ << @@.get<std::string>("t.apps.newShort"); %></a></div>
    <section class="section flow" role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.error.loadApplications"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
      <button class="button" type="button" data-applications-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>
  </div>
<%c++
} else {
// --- Разбор тела сервиса; сбой разбора — состояние ошибки, не падение ----
const std::string bodyJson = @@.get<std::string>("bodyJson");
const std::string statusFilter = @@.get<std::string>("statusFilter");
bool broken = false;
Json::Value apps(Json::arrayValue);
{
    Json::CharReaderBuilder rb;
    std::string errs;
    std::unique_ptr<Json::CharReader> reader(rb.newCharReader());
    Json::Value root;
    if (bodyJson.empty() ||
        !reader->parse(bodyJson.data(), bodyJson.data() + bodyJson.size(),
                       &root, &errs) ||
        !root.isMember("applications") || !root["applications"].isArray())
        broken = true;
    else
        apps = root["applications"];
}
const bool hasApps = !broken && apps.size() > 0;

// --- серверные константы и форматирование (паттерн grades.csp) -----------
const auto esc = [](const std::string& s) {
    return HttpViewData::htmlTranslate(s);
};
// «2026-11-02T09:12:00Z» → «2 ноября»/"2 November"/«11月2日» (имя месяца —
// словарь t.month.NN из view-данных, Р-16; zh — числовой формат)
const auto dayMonthOf = [&uiLang, &vstr](const std::string& iso) -> std::string {
    if (iso.size() < 10) return "";
    int d = 0, m = 0;
    try {
        d = std::stoi(iso.substr(8, 2));
        m = std::stoi(iso.substr(5, 2));
    } catch (...) {
        return "";
    }
    if (m < 1 || m > 12) return "";
    if (uiLang == "zh")
        return std::to_string(m) + "月" + std::to_string(d) + "日";
    return std::to_string(d) + " " +
           vstr((std::string("month.") + (m < 10 ? "0" : "") +
                 std::to_string(m)).c_str());
};
// Метка статуса — слова таймлайна 01 §4.4 (С7.5); словарь CHECK DDL
const auto statusTitle = [&vstr](const std::string& s) -> std::string {
    if (s == "draft") return vstr("apps.statusDraft");
    if (s == "submitted") return vstr("apps.statusSubmitted");
    if (s == "accepted") return vstr("apps.statusAccepted");
    if (s == "in_progress") return vstr("apps.statusInProgress");
    if (s == "need_info") return vstr("apps.statusNeedInfo");
    if (s == "ready") return vstr("apps.statusReady");
    if (s == "issued") return vstr("apps.statusIssued");
    if (s == "rejected") return vstr("apps.statusRejected");
    if (s == "cancelled") return vstr("apps.statusCancelled");
    return s;
};
// Класс бейджа (см. шапку шаблона): неизвестный статус — нейтральный
const auto badgeClass = [](const std::string& s) -> const char* {
    if (s == "submitted" || s == "accepted" || s == "in_progress")
        return "info";
    if (s == "need_info") return "warn";
    if (s == "ready" || s == "issued") return "success";
    if (s == "rejected" || s == "cancelled") return "danger";
    if (s == "draft") return "outline";
    return "";
};
// Заполнение mini-progress по текущему статусу (см. шапку шаблона)
const auto doneStages = [](const std::string& s) -> int {
    if (s == "submitted") return 1;
    if (s == "accepted") return 2;
    if (s == "in_progress" || s == "need_info") return 3;
    if (s == "ready") return 4;
    if (s == "issued") return 5;
    return 0;
};
%>
<%c++
// Группа фильтра по статусу (см. шапку): каждый статус — ровно в одной
const auto groupOf = [](const std::string& s) -> std::string {
    if (s == "submitted" || s == "accepted" || s == "in_progress")
        return "active";
    if (s == "need_info") return "reply";
    if (s == "rejected" || s == "cancelled") return "closed";
    return s;  // ready | issued | draft
};
// Витринный номер «З-2026-0001» (см. шапку)
const auto numberOf = [&vstr](const Json::Value& a) -> std::string {
    std::string id = std::to_string(a["id"].asInt64());
    while (id.size() < 4) id = "0" + id;
    const std::string created = a["created_at"].asString();
    const std::string year = created.size() >= 4 ? created.substr(0, 4) : "";
    return vstr("apps.numberPrefix") + "-" + year + "-" + id;
};
const auto pluralOf = [&vstr, &uiLang](long n) -> std::string {
    const long m10 = n % 10, m100 = n % 100;
    if (uiLang == "ru")
    {
        if (m10 == 1 && m100 != 11) return vstr("plural.applicationOne");
        if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14))
            return vstr("plural.applicationFew");
        return vstr("plural.applicationMany");
    }
    return vstr(n == 1 ? "plural.applicationOne" : "plural.applicationMany");
};
%>
  <div class="content-narrow">
    <div class="section-title"><h2><%c++ $$ << @@.get<std::string>("t.apps.history"); %></h2><a class="button primary" href="/applications/new"><%c++ $$ << @@.get<std::string>("t.apps.newShort"); %></a></div>
<%c++
if (broken) {
%>
    <section class="section flow" role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.error.loadApplications"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
      <button class="button" type="button" data-applications-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>
<%c++
} else if (!hasApps) {
    // Пусто (applications-states.html #empty): заявок нет совсем — фильтр
    // и поиск не рисуются, CTA «Открыть каталог» (03 §5.2:997).
%>
    <div id="applications-root" data-state="empty">
      <div class="surface">
        <div class="empty">
          <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5"/></svg></div>
          <h2><%c++ $$ << @@.get<std::string>("t.dash.emptyApplications"); %></h2>
          <p><%c++ $$ << @@.get<std::string>("t.apps.emptyText"); %></p>
          <a class="button" href="/applications/new"><%c++ $$ << @@.get<std::string>("t.apps.openCatalog"); %></a>
        </div>
      </div>
    </div>
<%c++
} else {
    // --- Данные (SSR): тулбар, счётчик, карточки-ссылки ----------------
    const std::pair<const char*, const char*> kGroups[] = {
        {"", "apps.filterAll"},         {"active", "apps.filterActive"},
        {"reply", "apps.filterReply"},  {"ready", "apps.filterReady"},
        {"issued", "apps.filterIssued"}, {"draft", "apps.filterDraft"},
        {"closed", "apps.filterClosed"}};
    long visible = 0;
    for (const auto& a : apps)
        if (statusFilter.empty() || groupOf(a["status"].asString()) == statusFilter)
            ++visible;
%>
    <div class="collection-toolbar" role="search">
      <div class="field">
        <label for="application-search"><%c++ $$ << @@.get<std::string>("t.apps.searchLabel"); %></label>
        <input id="application-search" type="search" autocomplete="off" placeholder="<%c++ $$ << @@.get<std::string>("t.apps.searchPlaceholder"); %>">
      </div>
      <div class="field">
        <label for="application-filter"><%c++ $$ << @@.get<std::string>("t.apps.filterLabel"); %></label>
        <select id="application-filter" name="status">
<%c++
    for (const auto& g : kGroups)
    {
        $$ << "<option value=\"" << g.first << "\"";
        if (statusFilter == g.first) $$ << " selected";
        $$ << ">" << esc(vstr(g.second)) << "</option>";
    }
%>
        </select>
      </div>
    </div>
    <p class="caption collection-count" aria-live="polite" data-apps-count data-one="<%c++ $$ << esc(vstr("plural.applicationOne")); %>" data-few="<%c++ $$ << esc(vstr("plural.applicationFew")); %>" data-many="<%c++ $$ << esc(vstr("plural.applicationMany")); %>"><%c++ $$ << visible << " " << esc(pluralOf(visible)); %></p>
    <div id="applications-root" data-state="data">
      <div class="app-list" id="application-list"<%c++ if (visible == 0) $$ << " hidden"; %>>
<%c++
        for (const auto& a : apps)
        {
            const std::string st = a["status"].asString();
            const std::string grp = groupOf(st);
            const int done = doneStages(st);
            const std::string number = numberOf(a);
            const std::string title = a["type_title"].asString();
            $$ << "<a class=\"app-card\" href=\"/applications/"
               << a["id"].asInt64() << "\" data-group=\"" << grp
               << "\" data-search=\"" << esc(title + " " + number) << "\"";
            if (!statusFilter.empty() && grp != statusFilter) $$ << " hidden";
            $$ << ">";
            $$ << "<div class=\"row wrap\"><h3>" << esc(title) << "</h3>";
            $$ << "<span class=\"badge " << badgeClass(st) << "\">"
               << esc(statusTitle(st)) << "</span></div>";
            // 5 стадий канонического пути (01 §4.4); aria-label читается
            // целиком — цвет/заполнение не единственный носитель (03 §6.4)
            $$ << "<div class=\"mini-progress\" aria-label=\""
               << vstr("apps.stagesPrefix")
               << (uiLang == "zh" ? "" : " ") << done
               << (uiLang == "zh" ? "" : " ") << vstr("apps.stagesTotal")
               << "\">";
            for (int i = 0; i < 5; ++i)
                $$ << "<span" << (i < done ? " class=\"done\"" : "")
                   << "></span>";
            $$ << "</div>";
            // Подпись эталона: номер · от даты · хвост по статусу (срок —
            // ориентир, не SLA; у need_info текста вопроса в теле списка
            // нет — честная подпись «деканат ждёт ваш ответ»)
            std::string tail;
            if (grp == "active") tail = vstr("apps.usualShort");
            else if (grp == "reply") tail = vstr("apps.replyCaption");
            else if (grp == "ready" || grp == "issued")
                tail = a["payload"].isObject() &&
                               a["payload"]["delivery"].isString() &&
                               a["payload"]["delivery"].asString() == "office"
                           ? vstr("apps.pickupOffice")
                           : vstr("apps.docAvailable");
            $$ << "<p class=\"caption\">" << esc(number) << " · "
               << vstr("apps.from") << (uiLang == "zh" ? "" : " ")
               << esc(dayMonthOf(a["created_at"].asString()));
            if (!tail.empty()) $$ << " · " << esc(tail);
            $$ << "</p></a>";
        }
%>
      </div>
      <div class="empty filtered-empty" data-apps-filtered-empty<%c++ if (visible > 0) $$ << " hidden"; %>>
        <h2><%c++ $$ << @@.get<std::string>("t.apps.filteredEmptyTitle"); %></h2>
        <p><%c++ $$ << @@.get<std::string>("t.apps.filteredEmptyText"); %></p>
        <button class="button" type="button" data-apps-reset><%c++ $$ << @@.get<std::string>("t.apps.resetFilters"); %></button>
      </div>
    </div>
<%c++
    }
}  // else (failed != "1")
%>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
