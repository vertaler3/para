<%inc
#include <json/json.h>
#include <memory>
#include <string>
%>
<%c++
/* Профиль человека (Э7, экран «Люди» 2/2; 03 §4.9.6, design-drafts/
   person.html). SSR-шапка: тело — PeopleService::profile (ТОТ ЖЕ метод,
   что стоит за JSON GET /v1/people/{id}; SQL в шаблоне нет — AGENTS
   §5.5), приходит сериализованной строкой bodyJson; разбор здесь,
   пользовательские строки выводит HttpViewData::htmlTranslate
   (02 §6.4, Р-16). Path-id БЕЗ OwnershipGuard — people общий каталог:
   403 не возникает (Р-15), НЕЧИСЛОВОЙ/несуществующий id контроллер
   отвечает 404 ЭТОЙ страницей (mode=notfound), ошибка БД — 500
   (mode=dberror, fail-closed) — HTML-карточки, НЕ голый JSON.
   Рендер ветвится ПО ДАННЫМ ОТВЕТА (постановка экрана):
     преподаватель/сотрудник (role teacher|staff) — полное имя,
       должность · кафедра, почта с кнопкой mailto «Написать»,
       кабинет ссылкой /map/rooms?q=<номер> (алиас карты — отдельный
       коммит этой же группы; ссылка ставится уже сейчас по постановке);
     студент (role student) — имя КАК ПРИШЛО (чужой — уже маскированное
       «И. Фамилия» на сервере, Р-15: рисовать как пришло, полные не
       восстанавливать), группа, почта; БЕЗ блоков оценок/заявок — даже
       заглушек (правило видимости 02 §5.2: их нет и в данных ответа по
       построению — ветвлению нечего рисовать). Свой студент (в ответе
       есть faculty/program/course) — дополнительно факультет/курс
       строкой меты (данные-ветвление, отдельной ветки не нужно).
   Блок «Занятия» / «Расписание группы» (заголовок по ветке) грузит
   клиент — GET /v1/people/{id}/schedule из app.js (постановка);
   в разметке — его состояния (03 §5): скелетон, пусто (текст по
   ветке: «Занятий нет» / «В расписании группы пар нет»), ошибка с
   «Повторить», офлайн — баннер каркаса (03 §5.4).
   Заголовок блока — h2 с data-ps-title: серверный дефолт по ветке,
   app.js дополняет его РЕАЛЬНЫМ диапазоном отрисованных занятий
   («Занятия 2–8 ноября», один день — «Занятия 4 ноября») — формулировка
   вайрфрейма 03 §4.9.6 («ЗАНЯТИЯ ЭТОЙ НЕДЕЛИ») и черновика
   design-drafts/person.html (правки по ревью раунд 1): данные
   eventsByTeacher не ограничены неделей, поэтому честный диапазон
   считает клиент по events (data.person.role); у студента заголовок
   блока остаётся «Расписание группы» (тоже 03 §4.9.6).
   data-person-id на body — уже провалидированный цифровой id от
   контроллера (запрос клиента к schedule). Скелетона SSR-шапки нет —
   страница целиком SSR (03 §5.1, прецедент application.csp). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js подключает страница
     (defer; htmx на этом экране не используется). -->
<script defer src="/static/js/app.js"></script>
<body data-page="person"<%c++ $$ << " data-person-id=\"" << HttpViewData::htmlTranslate(@@.get<std::string>("personId")) << "\""; %>>
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <a class="back" href="/people"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << @@.get<std::string>("t.common.back"); %></a>
<%c++
const std::string mode = @@.get<std::string>("mode");
const auto esc = [](const std::string& s) {
    return HttpViewData::htmlTranslate(s);
};
// 5.18 (fe_rebuild шаг 17): строки экрана — словарь t.person.* / t.people.*
// из view-данных (Р-16; контроллер кладёт бандл insertUiStrings).
const auto T = [&](const std::string& key) {
    return @@.get<std::string>("t." + key);
};
// Инициалы аватара: первые буквы двух слов ФИО (верхний регистр уже в
// данных сервера — и полных, и маскированных «И. Фамилия»).
// Кириллица — многобайтный UTF-8: берём lead-байт + его continuation
// (10xxxxxx), считаем БУКВЫ, не байты (рендер-проба поймала обе ошибки
// байт-арифметики: пустой аватар и «д» вместо номера кабинета).
const auto initialsOf = [](const std::string& fio) -> std::string {
    std::string out;
    int taken = 0;
    bool need = true;
    std::size_t i = 0;
    while (i < fio.size())
    {
        const unsigned char c = static_cast<unsigned char>(fio[i]);
        if (fio[i] == ' ' || fio[i] == '\t')
        {
            need = true;
            ++i;
            continue;
        }
        if ((c & 0xC0) == 0x80 || !need)
        {
            ++i;  // continuation-байт вне начала буквы / не начало слова
            continue;
        }
        out += fio[i++];  // lead-байт буквы + его continuation-цепочка
        while (i < fio.size() &&
               (static_cast<unsigned char>(fio[i]) & 0xC0) == 0x80)
            out += fio[i++];
        need = false;
        if (++taken >= 2) break;
    }
    return out;
};
// «Корпус А, ауд. 2105» → «2105» (для /map/rooms?q=): токен после
// «ауд.» до конца/разделителя; без «ауд.» — вся строка кабинета.
// find возвращает БАЙТОВЫЙ сдвиг — сдвигаемся на длину needle в байтах
// (needle «ауд.» — 7 байт UTF-8), иначе токен режется с середины слова.
const auto roomNoOf = [](const std::string& office) -> std::string {
    const std::string kAud = "ауд.";
    const std::size_t aud = office.find(kAud);
    std::size_t i = aud == std::string::npos ? 0 : aud + kAud.size();
    while (i < office.size() && office[i] == ' ') ++i;
    const std::size_t start = i;
    while (i < office.size() && office[i] != ',' && office[i] != ')' &&
           office[i] != '.')
        ++i;
    std::string room = office.substr(start, i - start);
    while (!room.empty() && room.back() == ' ') room.pop_back();
    return room;
};
std::string heading = T("person.title");
Json::Value person(Json::objectValue);
bool dataOk = false;
if (mode == "data")
{
    // Разбор тела сервиса; сбой разбора — состояние ошибки (03 §5.3),
    // не падение (прецедент application.csp).
    const std::string bodyJson = @@.get<std::string>("bodyJson");
    Json::CharReaderBuilder rb;
    std::string errs;
    std::unique_ptr<Json::CharReader> reader(rb.newCharReader());
    dataOk = !bodyJson.empty() &&
             reader->parse(bodyJson.data(), bodyJson.data() + bodyJson.size(),
                           &person, &errs) &&
             person.isMember("role") && person.isMember("fio");
    // v3 (person.html): h1 — «Профиль преподавателя/сотрудника/студента»,
    // ФИО — h2 в .profile-summary ниже.
    if (dataOk)
    {
        const std::string r = person["role"].asString();
        heading = r == "teacher" ? T("person.headTeacher")
                  : r == "staff" ? T("person.headStaff")
                                 : T("person.headStudent");
    }
}
$$ << "<h1>" << esc(heading) << "</h1>";
%>
    </div>
  </div>
  <div class="content-narrow">
<%c++
if (mode == "notfound")
{
    // 404 (нечисловой/несуществующий id — решение в шапке): нейтральная
    // карточка 03 §5.3, код статуса на ответе — 404 (HTML, не JSON).
%>
    <div class="surface">
      <div class="empty">
        <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.6a4.5 4.5 0 0 1 5 4.4"/></svg></div>
        <h2><%c++ $$ << @@.get<std::string>("t.person.notFoundTitle"); %></h2>
        <p><%c++ $$ << @@.get<std::string>("t.person.notFoundText"); %></p>
        <div class="actions">
          <a class="button" href="/people"><%c++ $$ << @@.get<std::string>("t.person.searchPeople"); %></a>
          <a class="button" href="/"><%c++ $$ << @@.get<std::string>("t.common.toHome"); %></a>
        </div>
      </div>
    </div>
<%c++
}
else if (mode == "dberror" || (mode == "data" && !dataOk))
{
    // Ошибка БД (fail-closed) или разбора тела — 03 §5.3:1013.
%>
    <section class="section flow" role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.person.svcDownTitle"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.person.svcDownText"); %></p>
      <button class="button" type="button" data-person-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>
<%c++
}
else
{
    // --- Данные: ветвление ПО ПОЛЯМ ОТВЕТА (см. шапку шаблона) ----------
    const std::string role = person["role"].asString();
    const std::string fio = person["fio"].asString();
    const bool staffLike = role == "teacher" || role == "staff";
    const std::string email = person.isMember("email") &&
                                      person["email"].isString()
                                  ? person["email"].asString()
                                  : "";
    const std::string group = person.isMember("group") &&
                                      person["group"].isString()
                                  ? person["group"].asString()
                                  : "";
    // Свой студент: сервер добавляет faculty/program/course (PeopleService
    // profile) — строка меты из того, что ЕСТЬ в данных.
    const bool selfStudent = !staffLike && person.isMember("faculty") &&
                             person["faculty"].isString();
    const std::string faculty =
        selfStudent ? person["faculty"].asString() : "";
    const bool hasCourse = selfStudent && person.isMember("course") &&
                           !person["course"].isNull();
    const std::string program =
        selfStudent && person.isMember("program") &&
                person["program"].isString()
            ? person["program"].asString()
            : "";
%>
    <div class="profile-summary">
      <span class="avatar large" aria-hidden="true"><%c++ $$ << esc(initialsOf(fio)); %></span>
      <div>
        <h2><%c++ $$ << esc(fio); %></h2>
        <p class="muted small"><%c++
        if (staffLike)
        {
            // должность · кафедра (могут быть пустыми в данных — optString)
            std::string sub;
            if (person.isMember("title") && person["title"].isString())
                sub = person["title"].asString();
            const std::string dept =
                person.isMember("department") && person["department"].isString()
                    ? person["department"].asString()
                    : "";
            if (!sub.empty() && !dept.empty())
                sub += " · " + dept;
            else if (dept.empty() && sub.empty())
                sub = role == "staff" ? T("people.roleStaff") : T("people.roleTeacher");
            else if (sub.empty())
                sub = dept;
            $$ << esc(sub);
        }
        else
        {
            std::string groupLabel = T("people.groupN");
            const auto gpos = groupLabel.find("{g}");
            if (gpos != std::string::npos) groupLabel.replace(gpos, 3, group);
            $$ << esc(T("people.roleStudent")) << (group.empty() ? "" : " · " + esc(groupLabel));
        }
        %></p>
<%c++
    if (selfStudent)
    {
%>
        <p class="caption"><%c++
        std::string courseLabel = T("profile.course");
        const auto npos = courseLabel.find("{n}");
        if (npos != std::string::npos && hasCourse)
            courseLabel.replace(npos, 3, std::to_string(person["course"].asInt64()));
        $$ << esc(faculty) << (hasCourse ? " · " + esc(courseLabel) : "");
        if (!program.empty()) $$ << " · " << esc(program); %></p>
<%c++
    }
    if (staffLike)
    {
%>
        <p class="caption"><%c++ $$ << T("person.fictional"); %></p>
<%c++
    }
%>
      </div>
    </div>
    <div class="section">
      <div>
<%c++
    if (!email.empty())
    {
%>
        <!-- v3 (person.html): почта строкой .list-row + icon-button
             «Скопировать почту» (navigator.clipboard, тост — app.js);
             mailto «Написать о консультации» с темой — у преподавателя и
             сотрудника. Часы приёма и запись на консультацию эталона не
             переносятся: таких данных нет. -->
        <div class="list-row">
          <div>
            <strong data-person-email><%c++ $$ << esc(email); %></strong>
            <p><%c++ $$ << (staffLike ? T("person.emailNote") : T("person.emailFake")); %></p>
          </div>
          <button class="icon-button" type="button" data-copy-email="<%c++ $$ << esc(email); %>" aria-label="<%c++ $$ << T("person.copyEmail"); %>" title="<%c++ $$ << T("person.copyEmail"); %>"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg></button>
        </div>
<%c++
    }
    if (staffLike && person.isMember("office") && person["office"].isString())
    {
        const std::string office = person["office"].asString();
        // Кабинет → /map/rooms?q=<номер> (алиас карты — отдельный коммит
        // этой же группы; ссылка живёт уже сейчас, постановка экрана —
        // до неё тап ловит временный guard app.js: честный тост вместо
        // 404, правки по ревью раунд 1).
%>
        <a class="list-row" href="/map?q=<%c++ $$ << esc(roomNoOf(office)); %>">
          <div>
            <strong><%c++ $$ << T("person.office"); %> · <%c++ $$ << esc(roomNoOf(office).empty() ? office : roomNoOf(office)); %></strong>
            <p><%c++ $$ << esc(office); %></p>
          </div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
<%c++
    }
    else if (!staffLike && group.empty())
    {
%>
        <div class="list-row"><div><strong><%c++ $$ << T("person.group"); %></strong><p>—</p></div></div>
<%c++
    }
%>
      </div>
<%c++
    if (staffLike && !email.empty())
    {
        // mailto с темой: тема — строка словаря, кодируется для URI
        // (пробелы/кириллица/CJK → %XX), адрес — данные (htmlTranslate).
        std::string subject;
        static const char* hex = "0123456789ABCDEF";
        for (const unsigned char c : T("person.consultSubject"))
        {
            if (std::isalnum(c) || c == '-' || c == '_' || c == '.')
                subject += static_cast<char>(c);
            else
            {
                subject += '%';
                subject += hex[c >> 4];
                subject += hex[c & 15];
            }
        }
%>
      <div class="actions section">
        <a class="button primary" href="mailto:<%c++ $$ << esc(email) << "?subject=" << subject; %>"><%c++ $$ << T("person.consult"); %></a>
      </div>
<%c++
    }
%>
    </div>
    <section class="section" data-person-schedule>
      <div class="section-title"><h2 data-ps-title><%c++ $$ << (staffLike ? T("person.lessons") : T("person.groupSchedule")); %></h2></div>

      <!-- Скелетон (03 §5.1): 2 строки-карточки расписания -->
      <div class="stack" data-ps-loading aria-busy="true" aria-label="<%c++ $$ << T("person.loadingLessons"); %>">
        <div class="skeleton card"></div>
        <div class="skeleton card"></div>
      </div>

      <!-- Ошибка (03 §5.3): «Повторить» — повторный fetch schedule -->
      <section class="section flow" data-ps-error hidden role="alert">
        <h3><%c++ $$ << T("person.errorLessons"); %></h3>
        <p class="muted"><%c++ $$ << T("error.checkInternet"); %></p>
        <button class="button" type="button" data-ps-retry><%c++ $$ << T("common.retry"); %></button>
      </section>

      <!-- Пусто: текст по ветке данных (сотрудник — занятий нет честным
           пустым списком сервиса; студент — группа без пар) -->
      <div class="empty" data-ps-empty hidden>
        <p><%c++ $$ << (staffLike ? T("person.noLessons") : T("person.noGroupLessons")); %></p>
      </div>

      <!-- Дни и пары строит app.js (компоненты каркаса: caption дня +
           .schedule-list/.lesson; статусы — как в расписании) -->
      <div data-ps-list hidden></div>
    </section>
<%c++
}  // else (mode == data && dataOk)
%>
  </div>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
