<%inc
#include <json/json.h>
#include <drogon/utils/Utilities.h>
#include <cmath>
#include <memory>
#include <string>
%>
<%c++
/* Экран дисциплины (Э7; 03 §4.9.3) — дизайн v3: design-drafts/v3/pages/
   discipline.html (+ discipline-english.html — закрытая дисциплина).
   Полная страница: partials каркаса; pageTitle/activeTab — view-переменные
   GradesCtrl::disciplinePage. Контент — SSR: тела GradesService::list/
   summary/exams — те же методы, что за JSON API 02 §5.2 (SQL в шаблоне
   нет, AGENTS §5.5) — приходят сериализованными строками listJson/
   summaryJson/examsJson; строки дисциплины фильтруются по disciplineId
   (контроллер уже ответил 404, если среди СВОИХ оценок нет ни одной с
   таким discipline_id — решение в шапке GradesCtrl.h).
   Строки интерфейса — словарь t.<key> (5.18, Р-16); пользовательские
   строки (дисциплина, компоненты, аудитории, комментарии) выводит
   HttpViewData::htmlTranslate.
   Состав (эталон → прод):
     шапка .study-summary — код, дисциплина, score_sum / max_sum (прод
       честнее «/ 100» эталона), бейджи типа контроля и статуса
       («В процессе» / «Порог достигнут» / «Зачёт получен» — из missing);
     notice.danger «до допуска не хватает N. Порог допуска — max_sum»
       (демо-правило сервиса: порог = Σmax выставленных компонентов,
       GradesService.h) или notice «порог набран» при missing == 0;
     «Из чего сложились N баллов» — .list-row компонентов (component,
       graded_at, attempt, score/max_score); плановых (невыставленных)
       компонентов в схеме нет — не рисуются;
     «План до допуска» — ползунки по ПРОД-компонентам с score < max_score,
       диапазон [score..max_score]; итог считает app.js (aria-live), подпись
       «прогноз, не ведомость» — ничего никуда не отправляется;
     «Сдать работу» эталона НЕ переносится (загрузки на BE нет) — честная
       заметка «работы сдаются в учебном кабинете курса»;
     «Сессия» — пересдача notice.danger с «Показать кабинет» → /map?q=,
       прочие события — a.exam-row → /grades#session.
   Состояния: data; error — failed=1/сбой разбора — «Повторить»
   ([data-grades-retry] — app.js); офлайн — баннер каркаса; скелетона нет —
   страница целиком SSR. */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js — сама страница
     (defer); htmx экрану не нужен — контент SSR. -->
<script defer src="/static/js/app.js"></script>
<body data-page="discipline">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <a class="back" href="/grades"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << @@.get<std::string>("t.common.back"); %></a>
      <h1><%c++ $$ << @@.get<std::string>("t.discipline.title"); %></h1>
    </div>
  </div>
<%c++
const std::string failed = @@.get<std::string>("failed");
const std::string uiLang = @@.get<std::string>("lang");
const auto vstr = [&](const char* key) {
    return @@.get<std::string>(std::string("t.") + key);
};
// Подстановка {name} в строку словаря (шаблоны ×3 с разным порядком слов)
const auto fill = [](std::string s, const std::string& k,
                     const std::string& v) {
    const auto pos = s.find(k);
    if (pos != std::string::npos) s.replace(pos, k.size(), v);
    return s;
};
if (failed == "1") {
%>
  <!-- Состояние «Ошибка» (03 §5.3): «Повторить» — перезагрузка страницы. -->
  <div class="content-narrow">
    <section class="section flow" role="alert">
      <h3><%c++ $$ << vstr("discipline.loadError"); %></h3>
      <p class="muted"><%c++ $$ << vstr("error.checkInternet"); %></p>
      <button class="button" type="button" data-grades-retry><%c++ $$ << vstr("common.retry"); %></button>
    </section>
  </div>
<%c++
} else {
// --- Разбор тел сервиса и выборка дисциплины -----------------------------
const std::string summaryJson = @@.get<std::string>("summaryJson");
const std::string listJson = @@.get<std::string>("listJson");
const std::string examsJson = @@.get<std::string>("examsJson");
bool broken = false;
int64_t disciplineId = 0;
try {
    disciplineId = std::stoll(@@.get<std::string>("disciplineId"));
} catch (...) {
    broken = true;  // view-данных нет — не падение, состояние ошибки
}
Json::Value summary(Json::objectValue);
Json::Value grades(Json::arrayValue);
Json::Value exams(Json::arrayValue);
{
    Json::CharReaderBuilder rb;
    std::string errs;
    std::unique_ptr<Json::CharReader> reader(rb.newCharReader());
    const auto parseTo = [&broken, &reader, &errs](const std::string& src,
                                                   Json::Value& out) {
        if (src.empty() || !reader->parse(src.data(), src.data() + src.size(),
                                          &out, &errs))
            broken = true;
    };
    parseTo(summaryJson, summary);
    Json::Value listRoot(Json::objectValue);
    parseTo(listJson, listRoot);
    if (listRoot.isMember("grades") && listRoot["grades"].isArray())
        grades = listRoot["grades"];
    Json::Value examsRoot(Json::objectValue);
    parseTo(examsJson, examsRoot);
    if (examsRoot.isMember("exams") && examsRoot["exams"].isArray())
        exams = examsRoot["exams"];
}
// Свои оценки этой дисциплины — в порядке выставления (GradesService::list)
Json::Value rows(Json::arrayValue);
for (const auto& g : grades)
    if (g["discipline_id"].asInt64() == disciplineId)
        rows.append(g);
// Строка сводки этой дисциплины (score_sum/max_sum/percent/missing)
Json::Value ds;
if (summary.isMember("disciplines") && summary["disciplines"].isArray())
    for (const auto& d : summary["disciplines"])
        if (d["discipline_id"].asInt64() == disciplineId) {
            ds = d;
            break;
        }
// События сессии по этой дисциплине
Json::Value examRows(Json::arrayValue);
for (const auto& e : exams)
    if (e["discipline_id"].asInt64() == disciplineId)
        examRows.append(e);

const bool ready = !broken && ds.isMember("discipline_id") && rows.size() > 0;

// --- форматирование (как в views/grades.csp) -----------------------------
const auto esc = [](const std::string& s) {
    return HttpViewData::htmlTranslate(s);
};
const auto pluralForm = [](int n, const std::string& one,
                           const std::string& few,
                           const std::string& many) -> const std::string& {
    const int m10 = n % 10, m100 = n % 100;
    if (m10 == 1 && m100 != 11) return one;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
};
const std::string ptOne = vstr("plural.pointOne");
const std::string ptFew = vstr("plural.pointFew");
const std::string ptMany = vstr("plural.pointMany");
const auto points = [&](int n) -> const std::string& {
    return pluralForm(n, ptOne, ptFew, ptMany);
};
// «2026-11-18T10:00:00Z» → «18 ноября» / "18 November" / «11月18日»
const auto dayMonthOf = [&uiLang, &vstr](const std::string& iso) -> std::string {
    if (iso.size() < 10) return "";
    int d = 0, m = 0;
    try {
        d = std::stoi(iso.substr(8, 2));
        m = std::stoi(iso.substr(5, 2));
    } catch (...) {
        return "";
    }
    if (m < 1 || m > 12) return "";
    if (uiLang == "zh")
        return std::to_string(m) + "月" + std::to_string(d) + "日";
    return std::to_string(d) + " " +
           vstr((std::string("month.") + (m < 10 ? "0" : "") +
                 std::to_string(m)).c_str());
};
const auto timeOf = [](const std::string& iso) {
    return iso.size() >= 16 ? iso.substr(11, 5) : std::string("--:--");
};
const auto examKindLabel = [&vstr](const std::string& k) -> std::string {
    if (k == "consultation") return vstr("exam.consultation");
    if (k == "exam") return vstr("exam.exam");
    if (k == "credit") return vstr("exam.credit");
    if (k == "retake") return vstr("exam.retake");
    return "";
};
// Тип контроля — словарь CHECK 0002; бейджи 03 §4.4
const auto controlBadge = [&esc, &vstr](const std::string& ct) -> std::string {
    if (ct == "exam")
        return "<span class=\"badge info\">" + vstr("control.exam") + "</span>";
    if (ct == "credit")
        return "<span class=\"badge success\">" + vstr("control.credit") +
               "</span>";
    if (ct == "graded_credit")
        return "<span class=\"badge\">" + vstr("control.gradedCredit") +
               "</span>";
    return "<span class=\"badge\">" + esc(ct) + "</span>";
};
%>
<%c++
if (!ready) {
    // Защитная ветка (контроллер отвечает 404 до рендера, если своих
    // оценок с таким id нет; сюда попадаем только при сбое данных)
%>
  <div class="content-narrow">
    <section class="section flow" role="alert">
      <h3><%c++ $$ << vstr("discipline.loadError"); %></h3>
      <p class="muted"><%c++ $$ << vstr("error.checkInternet"); %></p>
      <button class="button" type="button" data-grades-retry><%c++ $$ << vstr("common.retry"); %></button>
    </section>
  </div>
<%c++
} else {
    const int missing = ds["missing"].asInt();
    const int scoreSum = static_cast<int>(ds["score_sum"].asInt64());
    const int maxSum = static_cast<int>(ds["max_sum"].asInt64());
    const std::string controlType = ds["control_type"].asString();
%>
  <div class="content-narrow">
    <!-- Шапка (эталон discipline.html): overline — код дисциплины (профиля
         во view нет, аудит D1), баллы tnum, бейджи типа и статуса -->
    <div class="study-summary">
      <div>
        <p class="overline"><%c++ $$ << esc(ds["code"].asString()); %></p>
        <h2><%c++ $$ << esc(ds["discipline"].asString()); %></h2>
        <p class="metric"><span class="tnum"><%c++ $$ << scoreSum; %></span><span class="caption"> / <%c++ $$ << maxSum; %></span></p>
      </div>
      <div class="badge-col">
<%c++
        $$ << controlBadge(controlType);
        // Статус из missing: «Зачёт получен» (эталон discipline-english,
        // зачёт без недобора, E1) / «Порог достигнут» / «В процессе»
        if (missing > 0)
            $$ << "<span class=\"badge\">" << vstr("discipline.inProgress")
               << "</span>";
        else
            $$ << "<span class=\"badge success\">"
               << vstr(controlType == "credit" ? "grades.creditPassed"
                                               : "grades.thresholdReached")
               << "</span>";
%>
      </div>
    </div>
<%c++
    if (missing > 0)
    {
        // notice.danger эталона: «До допуска не хватает N. Порог — M».
        // Подсказки «завершите модуль 3» нет — плановых компонентов в
        // данных нет (D3); вместо неё — путь к событиям сессии.
        $$ << "<div class=\"notice danger section\"><p>"
           << vstr("grades.missingPrefix") << (uiLang == "zh" ? "" : " ")
           << missing << (uiLang == "zh" ? "" : " ") << points(missing)
           << ". "
           << fill(vstr("discipline.thresholdIs"), "{m}", std::to_string(maxSum))
           << "</p><a class=\"button ghost\" href=\"/grades#session\">"
           << vstr("discipline.howToRecover") << "</a></div>";
    }
    else
    {
        // Закрытая дисциплина (discipline-english.html, E4)
        $$ << "<p class=\"notice section\">"
           << fill(fill(vstr("discipline.closedNote"), "{n}",
                        std::to_string(scoreSum)),
                   "{m}", std::to_string(maxSum))
           << "</p>";
    }
%>
    <section class="section">
      <div class="section-title"><h2><%c++ $$ << fill(fill(vstr("discipline.breakdown"), "{n}", std::to_string(scoreSum)), "{pts}", points(scoreSum)); %></h2></div>
      <div class="grade-list">
<%c++
        // .list-row эталона: компонент + «Выставлено {дата} · попытка N»,
        // справа score / max_score (D4). Пересдача — attempt > 1.
        for (const auto& g : rows)
        {
            const int64_t attempt = g["attempt"].asInt64();
            $$ << "<div class=\"list-row\"><div><strong>"
               << esc(g["component"].asString()) << "</strong><p>"
               << fill(vstr("discipline.gradedOn"), "{date}",
                       esc(dayMonthOf(g["graded_at"].asString())));
            if (attempt > 1)
                $$ << " · <span class=\"red\">"
                   << fill(vstr("discipline.attempt"), "{n}",
                           std::to_string(attempt))
                   << "</span>";
            $$ << "</p></div><strong class=\"tnum\">"
               << g["score"].asInt64() << " / " << g["max_score"].asInt64()
               << "</strong></div>";
        }
%>
      </div>
    </section>
<%c++
    // «План до допуска» (эталон: section.enh-panel с ползунками). Только
    // при недоборе и только по ПРОД-компонентам с score < max_score:
    // ползунок [score..max_score], итог считает app.js. Ничего не
    // сохраняется и не отправляется — прогноз, не ведомость (D6).
    if (missing > 0)
    {
%>
    <section class="section enh-panel" aria-labelledby="admission-title" data-admission-plan data-plan-score="<%c++ $$ << scoreSum; %>" data-plan-threshold="<%c++ $$ << maxSum; %>">
      <div class="section-title"><h2 id="admission-title"><%c++ $$ << vstr("discipline.planTitle"); %></h2><span class="enh-demo-label"><%c++ $$ << vstr("discipline.planBadge"); %></span></div>
      <p class="small muted"><%c++ $$ << fill(fill(vstr("discipline.planHint"), "{n}", std::to_string(scoreSum)), "{pts}", points(scoreSum)); %></p>
<%c++
        int idx = 0;
        for (const auto& g : rows)
        {
            const int64_t score = g["score"].asInt64();
            const int64_t maxScore = g["max_score"].asInt64();
            ++idx;
            if (score >= maxScore)
                continue;
            const std::string fid = "plan-" + std::to_string(idx);
            $$ << "<div class=\"field\"><label for=\"" << fid << "\">"
               << esc(g["component"].asString()) << ": <output id=\"" << fid
               << "-value\" for=\"" << fid << "\">" << score << "</output> "
               << vstr("discipline.planOf") << " " << maxScore
               << "</label><input id=\"" << fid << "\" type=\"range\" min=\""
               << score << "\" max=\"" << maxScore << "\" step=\"1\" value=\""
               << score << "\" data-plan-base=\"" << score << "\"></div>";
        }
%>
      <p class="notice danger" id="admission-result" role="status" aria-live="polite"><%c++
        $$ << fill(fill(vstr("discipline.planTotal"), "{n}", std::to_string(scoreSum)), "{m}", std::to_string(maxSum))
           << " "
           << fill(fill(vstr("discipline.planLeft"), "{n}", std::to_string(missing)), "{pts}", points(missing));
%></p>
    </section>
<%c++
    }
%>
    <!-- «Сдать работу» эталона не переносится: загрузки на BE нет, файл
         никуда бы не ушёл (инвариант честности данных, D8) -->
    <p class="notice section" id="assignment"><%c++ $$ << vstr("discipline.worksNote"); %></p>
<%c++
    // Комментарий преподавателя — при наличии, в кавычках (03 §4.9.3)
    std::string comments;
    const std::string qOpen = uiLang == "ru" ? "«" : (uiLang == "zh" ? "“" : "“");
    const std::string qClose = uiLang == "ru" ? "»" : "”";
    for (const auto& g : rows)
    {
        if (g.isMember("comment") && !g["comment"].isNull())
        {
            comments += "<p class=\"small\">" + qOpen +
                        esc(g["comment"].asString()) + qClose + " — " +
                        esc(g["component"].asString()) + "</p>";
        }
    }
    if (!comments.empty())
    {
%>
    <section class="section">
      <div class="section-title"><h2><%c++ $$ << vstr("discipline.teacherComment"); %></h2></div>
      <div class="notice"><%c++ $$ << comments; %></div>
    </section>
<%c++
    }
    if (examRows.size() > 0)
    {
%>
    <section class="section" id="session">
      <div class="section-title"><h2><%c++ $$ << vstr("grades.session"); %></h2></div>
<%c++
        // Пересдача — notice.danger эталона (#retake) с «Показать кабинет»
        // → /map?q=<аудитория> (map.csp понимает ?q=, D10)
        bool hasOther = false;
        for (const auto& e : examRows)
        {
            if (e["kind"].asString() != "retake") { hasOther = true; continue; }
            const std::string room = e["room"].asString();
            $$ << "<div class=\"notice danger retake-block\" id=\"retake\"><strong>"
               << esc(ds["discipline"].asString()) << " · "
               << vstr("exam.retake") << "</strong><p>"
               << esc(dayMonthOf(e["starts_at"].asString())) << ", "
               << esc(timeOf(e["starts_at"].asString()));
            if (!room.empty())
                $$ << " · " << vstr("grades.roomShort") << " " << esc(room);
            $$ << "</p>";
            if (!room.empty())
                $$ << "<a class=\"button ghost\" href=\"/map?q="
                   << esc(drogon::utils::urlEncodeComponent(room)) << "\">"
                   << vstr("discipline.showRoom") << "</a>";
            $$ << "</div>";
        }
        if (hasOther)
        {
            $$ << "<div class=\"grade-list\">";
            for (const auto& e : examRows)
            {
                const std::string kind = e["kind"].asString();
                if (kind == "retake") continue;
                $$ << "<a class=\"exam-row\" href=\"/grades#session\"><div><strong>"
                   << examKindLabel(kind) << "</strong><p class=\"caption\">"
                   << vstr("grades.roomShort") << " "
                   << esc(e["room"].asString()) << "</p></div>";
                $$ << "<strong class=\"tnum exam-when\">"
                   << esc(dayMonthOf(e["starts_at"].asString())) << " · "
                   << esc(timeOf(e["starts_at"].asString())) << "</strong></a>";
            }
            $$ << "</div>";
        }
%>
      <div class="actions">
        <a class="button" href="/grades#session"><%c++ $$ << vstr("discipline.allSessionEvents"); %></a>
      </div>
    </section>
<%c++
    }
%>
  </div>
<%c++
    }
}  // else (failed != "1")
%>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
