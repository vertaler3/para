<%c++
/* Карта кампуса — дизайн v3 (design-drafts/v3/pages/map.html), Р-32: вместо 3D Three.js
   и OSM-контуров эталона — интерактивная SVG-схема кампуса, которую строит
   static/js/app.js из прод-данных GET /v1/map/buildings + GET /v1/map/rooms
   (только createElement/createElementNS/textContent — 02 §6.4). Страница данных не
   содержит. Разметка эталона: section.campus-explorer (__head, campus-view-switch,
   campus-scene, campus-controls, campus-pan-control, campus-map-meta,
   campus-building-picker, __bottom) + campus-source-note + map-layout «Найти
   аудиторию → корпус → этаж → план этажа → карточка помещения».
   Компас и поворот эталона не переносятся: схема не ориентирована по сторонам света.
   Deep link: ?q= (алиас /map/rooms?q= → 303 /map?q=), ?room= (синоним эталона),
   ?building=<id>. Состояния: скелетон сцены (> 300 мс), пусто, ошибка с «Повторить»,
   офлайн — баннер каркаса + disabled поиск (data-network-action). Строки — словарь
   map.* (5.18). */
%>
<%view head %>
<script defer src="/static/js/app.js"></script>
<body data-page="map">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <a class="back" href="/profile"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << @@.get<std::string>("t.nav.profile"); %></a>
      <h1><%c++ $$ << @@.get<std::string>("t.campus.map"); %></h1>
      <p><%c++ $$ << @@.get<std::string>("t.map.subtitle"); %></p>
    </div>
  </div>

  <section class="campus-explorer" aria-labelledby="campus-title">
    <div class="campus-explorer__head">
      <div><h2 id="campus-title"><%c++ $$ << @@.get<std::string>("t.map.campusTitle"); %></h2><p><%c++ $$ << @@.get<std::string>("t.map.campusSub"); %></p></div>
      <div class="campus-view-switch">
        <button class="button" type="button" data-campus-action="top" aria-pressed="false"><%c++ $$ << @@.get<std::string>("t.map.viewTop"); %></button>
        <button class="button" type="button" data-campus-action="reset"><%c++ $$ << @@.get<std::string>("t.map.viewReset"); %></button>
      </div>
    </div>
    <div class="campus-scene-shell">
      <div class="campus-scene" data-campus-scene tabindex="0" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.map.sceneLabel"); %>" aria-describedby="campus-controls-help campus-keys-help">
        <div class="campus-loading campus-state" data-campus-loading hidden role="status">
          <div class="skeleton block campus-skeleton" aria-hidden="true"></div>
          <span><%c++ $$ << @@.get<std::string>("t.map.loading"); %></span>
        </div>
        <div class="campus-loading campus-state" data-campus-error hidden role="alert">
          <h3><%c++ $$ << @@.get<std::string>("t.map.errorLoad"); %></h3>
          <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
          <button class="button" type="button" data-campus-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
        </div>
        <div class="campus-loading campus-state" data-campus-empty hidden>
          <h3><%c++ $$ << @@.get<std::string>("t.map.emptyTitle"); %></h3>
          <p class="muted"><%c++ $$ << @@.get<std::string>("t.map.emptyText"); %></p>
        </div>
      </div>
      <div class="campus-controls" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.map.zoomGroup"); %>">
        <button type="button" data-campus-action="zoom-in" aria-label="<%c++ $$ << @@.get<std::string>("t.map.zoomIn"); %>" title="<%c++ $$ << @@.get<std::string>("t.map.zoomIn"); %>">+</button>
        <button type="button" data-campus-action="zoom-out" aria-label="<%c++ $$ << @@.get<std::string>("t.map.zoomOut"); %>" title="<%c++ $$ << @@.get<std::string>("t.map.zoomOut"); %>">−</button>
      </div>
      <div class="campus-pan-control" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.map.panGroup"); %>">
        <button type="button" data-campus-action="pan-up" aria-label="<%c++ $$ << @@.get<std::string>("t.map.panUp"); %>" title="<%c++ $$ << @@.get<std::string>("t.map.panUp"); %>">↑</button>
        <button type="button" data-campus-action="pan-left" aria-label="<%c++ $$ << @@.get<std::string>("t.map.panLeft"); %>" title="<%c++ $$ << @@.get<std::string>("t.map.panLeft"); %>">←</button>
        <button type="button" data-campus-action="pan-down" aria-label="<%c++ $$ << @@.get<std::string>("t.map.panDown"); %>" title="<%c++ $$ << @@.get<std::string>("t.map.panDown"); %>">↓</button>
        <button type="button" data-campus-action="pan-right" aria-label="<%c++ $$ << @@.get<std::string>("t.map.panRight"); %>" title="<%c++ $$ << @@.get<std::string>("t.map.panRight"); %>">→</button>
      </div>
      <div class="campus-map-meta" data-campus-selection><strong><%c++ $$ << @@.get<std::string>("t.map.sceneLabel"); %></strong><span><%c++ $$ << @@.get<std::string>("t.map.metaHint"); %></span></div>
    </div>
    <div class="campus-building-picker">
      <label for="campus-building-picker"><%c++ $$ << @@.get<std::string>("t.map.showBuilding"); %></label>
      <select id="campus-building-picker" data-campus-picker>
        <option value=""><%c++ $$ << @@.get<std::string>("t.map.wholeCampus"); %></option>
      </select>
    </div>
    <div class="campus-explorer__bottom">
      <div>
        <p data-campus-status role="status" aria-live="polite"><%c++ $$ << @@.get<std::string>("t.map.loading"); %></p>
        <p class="campus-keyboard-help" id="campus-controls-help"><%c++ $$ << @@.get<std::string>("t.map.helpPointer"); %></p>
        <p class="campus-keyboard-help" id="campus-keys-help"><%c++ $$ << @@.get<std::string>("t.map.helpKeys"); %></p>
      </div>
    </div>
  </section>
  <p class="campus-source-note"><%c++ $$ << @@.get<std::string>("t.map.sourceNote"); %></p>

  <div class="map-layout section">
    <div class="flow">
      <form id="room-search-form" data-map-form>
        <label for="room-search"><%c++ $$ << @@.get<std::string>("t.map.findRoom"); %></label>
        <div class="row">
          <input id="room-search" name="q" type="search" placeholder="<%c++ $$ << @@.get<std::string>("t.map.searchPlaceholder"); %>" autocomplete="off" required data-map-q>
          <button class="icon-button" type="submit" aria-label="<%c++ $$ << @@.get<std::string>("t.map.findRoom"); %>" data-network-action><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>
        </div>
        <p class="caption" id="map-search-result" role="status" data-search-status></p>
        <div class="chips map-search-results" data-search-results hidden></div>
        <button class="button" type="button" data-search-retry data-network-action hidden><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
      </form>
      <div class="field">
        <label for="map-building"><%c++ $$ << @@.get<std::string>("t.map.building"); %></label>
        <select id="map-building" data-map-building>
          <option value=""><%c++ $$ << @@.get<std::string>("t.map.chooseBuilding"); %></option>
        </select>
      </div>
      <div class="field">
        <label for="map-floor"><%c++ $$ << @@.get<std::string>("t.map.floor"); %></label>
        <select id="map-floor" data-map-floor disabled></select>
      </div>
      <p class="notice"><%c++ $$ << @@.get<std::string>("t.map.planNote"); %></p>
    </div>
    <div>
      <div class="section-title"><h2 id="map-location" data-map-location><%c++ $$ << @@.get<std::string>("t.map.chooseBuilding"); %></h2></div>
      <div class="map-plan map-plan--floor" data-rooms-grid hidden></div>
      <p class="notice section" data-rooms-hint><%c++ $$ << @@.get<std::string>("t.map.planHint"); %></p>
      <p class="notice section" data-rooms-empty hidden></p>
      <div class="surface section flow" id="room-detail" data-room-detail>
        <span class="overline"><%c++ $$ << @@.get<std::string>("t.map.roomCard"); %></span>
        <h2 id="room-detail-title" data-room-title><%c++ $$ << @@.get<std::string>("t.map.roomPick"); %></h2>
        <p class="small muted" data-room-body><%c++ $$ << @@.get<std::string>("t.map.roomPickHint"); %></p>
        <div class="actions" data-room-actions hidden>
          <a class="button primary" href="/rooms"><%c++ $$ << @@.get<std::string>("t.map.book"); %></a>
        </div>
      </div>
    </div>
  </div>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
