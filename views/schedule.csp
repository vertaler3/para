<%c++
/* Расписание (Э7, экран 1 из 2; 03 §4.3, design-drafts/schedule.html и
   schedule-week.html). Полная страница: partials каркаса, activeTab=
   "schedule" и pageTitle — view-переменные, которые ставит ScheduleCtrl::page
   (Data-вставки — только серверные константы, 02 §6.4). Контент сегмента
   «Сегодня | Неделя» — SSR: страница включает партиал schedule_today /
   schedule_week по view-переменной segment; ТЕ ЖЕ партиалы возвращаются
   контроллером как ответ htmx на GET /schedule/segment (HX-Request: true) —
   outerHTML-обмен контейнера #schedule-segment, его data-state="data|empty"
   (смок состояния) приезжает свежим с каждым фрагментом.
   Синтаксис drogon v1.9.14: {{}} НЕ существует (Р-16) — строки-данные
   вставляет партиал через $$ << с HttpViewData::htmlTranslate.
   htmx — вендоренный локальный файл static/vendor/htmx.min.js (AGENTS §3;
   лицензия BSD-2-Clause — docs/decisions.md Р-18), подключён до app.js:
   порядок defer = порядок исполнения, htmx обрабатывает hx-атрибуты на
   DOMContentLoaded. Vanilla JS (static/js/app.js): sheet «Детали пары»
   (03 §4.3 — <dialog>, тап по карточке пары), состояния «Ошибка»
   (htmx:afterRequest !successful → #schedule-error с «Повторить» —
   ретриггер исходного запроса, 03 §5.3) и «Офлайн» (htmx:sendError →
   баннер каркаса, 03 §5.4); скелетон #schedule-indicator — hx-indicator
   всех сегментных запросов (shimmer каркаса).
   5.18 (шаг 3): строки страницы — словарь t.<key> из view-данных
   (ScheduleCtrl::page + i18n::insertUiStrings ДО рендера, Р-16); сегментные
   партиалы (today/week) получают ТЕ ЖЕ view-данные — и при SSR-включении
   сюда, и как самостоятельный htmx-ответ (ScheduleCtrl::segment тоже кладёт
   бандл). Пользовательские строки (дисциплины/аудитории) экранируются
   htmlTranslate как раньше (02 §6.4). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: страница подключает htmx
     (вендоренно, Р-18; до app.js — порядок defer) и app.js. -->
<script defer src="/static/vendor/htmx.min.js"></script>
<script defer src="/static/js/app.js"></script>
<body data-page="schedule">
<%view topbar %>
<main id="main" class="shell">
<%c++
/* v3 (fe_rebuild шаги 3–4): заголовок страницы зависит от сегмента — «День»:
   «Расписание», «Неделя»: «Учебная неделя» (эталон schedule-week.html); при
   htmx-обмене сегмента app.js переносит data-heading/data-lead корня
   #schedule-segment в h1/p. */
const std::string seg = @@.get<std::string>("segment");
const bool weekSeg = seg == "week";
%>
  <div class="page-heading">
    <div>
      <h1 data-schedule-heading><%c++ $$ << @@.get<std::string>(weekSeg ? "t.schedule.weekTitle" : "t.nav.schedule"); %></h1>
      <p data-schedule-lead><%c++ $$ << @@.get<std::string>(weekSeg ? "t.schedule.weekLead" : "t.schedule.subtitle"); %></p>
    </div>
  </div>
  <!-- Состояние «Загрузка» (schedule-states.html#loading): скелетон —
       hx-indicator всех сегментных запросов (видим только под .htmx-request). -->
  <div id="schedule-indicator" class="htmx-indicator schedule-skeleton" aria-busy="true" aria-label="<%c++ $$ << @@.get<std::string>("t.common.loading"); %>">
    <div class="skeleton title"></div><div class="skeleton block"></div><div class="skeleton short"></div><div class="skeleton block"></div>
  </div>
<%c++ if (weekSeg) { %>
<%view schedule_week %>
<%c++ } else { %>
<%view schedule_today %>
<%c++ } %>
  <!-- Состояние «Ошибка» (schedule-states.html#error): показывает app.js по
       htmx:afterRequest (!successful) / htmx:sendError; «Повторить»
       перезапускает запрос элемента, на котором он оборвался. -->
  <section class="section flow" id="schedule-error" hidden role="alert">
    <h3><%c++ $$ << @@.get<std::string>("t.error.loadSchedule"); %></h3>
    <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
    <button class="button" type="button" data-schedule-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
  </section>
  <!-- Диалог занятия (эталон .lesson-dialog + .detail-list; schedule-change.html
       — блок «было → стало» внутри диалога). Поля заполняет app.js из
       data-атрибутов карточки (только textContent — 02 §6.4); ФИО
       преподавателя — GET /v1/people/{teacher_id+1000} (Р-15). Закрытие —
       × / «Закрыть» / Esc, фокус возвращается на кнопку-инициатор. -->
  <dialog id="lesson-sheet" class="lesson-dialog" aria-labelledby="lesson-dialog-title">
    <div class="dialog-title">
      <h2 id="lesson-dialog-title" data-sheet-title><%c++ $$ << @@.get<std::string>("t.schedule.sheetTitle"); %></h2>
      <button class="icon-button" type="button" data-sheet-close aria-label="<%c++ $$ << @@.get<std::string>("t.common.close"); %>"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
    <p class="lesson-dialog-time" data-sheet-time></p>
    <dl class="detail-list">
      <div><dt><%c++ $$ << @@.get<std::string>("t.schedule.sheetWhen"); %></dt><dd data-sheet-when></dd></div>
      <div><dt><%c++ $$ << @@.get<std::string>("t.schedule.sheetRoom"); %></dt><dd><span data-sheet-room></span> <a data-sheet-map href="/map"><%c++ $$ << @@.get<std::string>("t.schedule.onMap"); %></a></dd></div>
      <div><dt><%c++ $$ << @@.get<std::string>("t.schedule.sheetKind"); %></dt><dd data-sheet-kind></dd></div>
      <div><dt><%c++ $$ << @@.get<std::string>("t.schedule.sheetStatus"); %></dt><dd data-sheet-status></dd></div>
      <div><dt><%c++ $$ << @@.get<std::string>("t.schedule.sheetTeacher"); %></dt><dd><a data-sheet-teacher hidden href="/people"></a><span class="muted" data-sheet-teacher-empty>—</span></dd></div>
    </dl>
    <div class="change-block" data-sheet-change-row hidden>
      <span class="change-label" data-sheet-change-label></span>
      <div class="change-route" data-sheet-change></div>
      <p class="caption" data-sheet-change-note></p>
    </div>
    <div class="actions section">
      <a class="button" href="/profile#calendar"><%c++ $$ << @@.get<std::string>("t.profile.icsAdd"); %></a>
      <button class="button ghost" type="button" data-sheet-close><%c++ $$ << @@.get<std::string>("t.common.close"); %></button>
    </div>
  </dialog>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
