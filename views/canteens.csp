<%c++
/* Столовые (5.13; дизайн v3 — design-drafts/v3/pages/cafeteria.html,
   fe_rebuild шаг 20). Страница статична: список (GET /v1/canteens) и меню
   выбранной столовой (GET /v1/canteens/{id}/menu) грузит static/js/app.js
   (только createElement/textContent — 02 §6.4).
   Раскладка эталона: чипы «Название · Корпус», строка часов работы,
   комбо-блоки .combo (цена, details «КБЖУ», «Добавить +»), группы
   категорий .list-row с КБЖУ caption, ценой и «Добавить +». Панель
   «Ваш обед» (.enh-panel) — калькулятор суммы цены и КБЖУ ТОЛЬКО в памяти
   страницы (без localStorage и без отправки; степпер −/+, «Очистить»),
   null-КБЖУ — «нет данных», не ноль. Фильтр диет, состав и граммовка,
   дата меню и «Сохранить набор» эталона не переносятся — нет полей /
   хранение было бы демо-localStorage. Состояния (03 §5): скелетон при
   ответе > 300 мс, пусто, ошибка с «Повторить», офлайн — баннер каркаса.
   Строки — словарь canteens.* ×3 (5.18). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js подключает страница
     (defer; htmx на этом экране не используется). -->
<script defer src="/static/js/app.js"></script>
<body data-page="canteens">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <a class="back" href="/profile"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << @@.get<std::string>("t.common.back"); %></a>
      <h1><%c++ $$ << @@.get<std::string>("t.canteens.title"); %></h1>
      <p><%c++ $$ << @@.get<std::string>("t.canteens.subtitle"); %></p>
    </div>
  </div>
  <div class="content-narrow">

    <!-- Чипы столовых «Название · Корпус» (строит app.js из GET /v1/canteens) -->
    <div class="chips" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.canteens.list"); %>" data-canteen-chips></div>

    <!-- Часы выбранной столовой (эталон: caption над меню) -->
    <p class="caption section" data-canteen-hours hidden></p>

    <!-- Скелетон (03 §5.1): показывается app.js ТОЛЬКО при ответе > 300 мс -->
    <div class="section stack" data-menu-loading hidden aria-busy="true" aria-label="<%c++ $$ << @@.get<std::string>("t.canteens.loading"); %>">
      <div class="skeleton block"></div>
      <div class="skeleton card"></div>
      <div class="skeleton card"></div>
      <div class="skeleton card"></div>
    </div>

    <div class="empty" data-menu-empty hidden>
      <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3v7a3 3 0 0 0 6 0V3M7 3v18M20 3c-4 2-5 5-5 9h5V3Zm0 9v9"/></svg></div>
      <h2><%c++ $$ << @@.get<std::string>("t.canteens.emptyTitle"); %></h2>
      <p><%c++ $$ << @@.get<std::string>("t.canteens.emptyText"); %></p>
    </div>

    <section class="section flow" data-menu-error hidden role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.canteens.errorMenu"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
      <button class="button" type="button" data-menu-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>

    <!-- Меню: комбо-блоки и группы категорий строит app.js -->
    <div data-menu-body hidden></div>

    <p class="caption section"><%c++ $$ << @@.get<std::string>("t.canteens.fictional"); %></p>

    <!-- «Ваш обед» (эталон #meal-planner): только память страницы -->
    <section class="section enh-panel" aria-labelledby="meal-title" data-meal>
      <div class="section-title">
        <h2 id="meal-title"><%c++ $$ << @@.get<std::string>("t.canteens.mealTitle"); %></h2>
        <span class="enh-demo-label"><%c++ $$ << @@.get<std::string>("t.canteens.mealLabel"); %></span>
      </div>
      <div aria-live="polite" data-meal-items>
        <p class="small muted"><%c++ $$ << @@.get<std::string>("t.canteens.mealEmpty"); %></p>
      </div>
      <div class="enh-meal-total" data-meal-total hidden></div>
      <div class="actions section">
        <button class="button ghost" type="button" data-meal-clear disabled><%c++ $$ << @@.get<std::string>("t.canteens.clear"); %></button>
      </div>
      <p class="caption" role="status" data-meal-status><%c++ $$ << @@.get<std::string>("t.canteens.planNote"); %></p>
    </section>

  </div>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
