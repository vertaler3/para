<%inc
#include <json/json.h>
#include <memory>
#include <string>
#include "utils/ScheduleView.h"
%>
<%c++
/* Пара · сегмент «Неделя» расписания (Э7; дизайн v3 — design-drafts/v3/pages/
   schedule-week.html, переработка в языке нового дизайна по Р-32; fe_rebuild
   шаг 4). Рендерится страницей views/schedule.csp (SSR) и возвращается
   контроллером как ОТВЕТ htmx на GET /schedule/segment?segment=week&offset=N
   (или &date=…) — корень #schedule-segment (data-state, data-heading/
   data-lead) при outerHTML-обмене приезжает свежим; имя класса —
   schedule_week (дефис drogon_ctl 1.9.14 в имя класса не допускает).
   Данные — view-строки контроллера: bodyJson — ScheduleService::week
   ({offset, from, to, events}); realTodayIso — реальное сегодня UTC.
   week-board эталона: ось времени 09:00–19:00 (calendar-axis), семь колонок
   day-group (сокращённый день + число, полное название — sr-only), сегодня —
   .is-today.today-column; позиция пары — style="--event-row/--event-span"
   из starts_at/ends_at (src/utils/ScheduleView.h gridPos: строка = 30 мин,
   вне окна — прижим к краю, время в карточке настоящее). На <1200px CSS
   эталона кладёт дни стопкой/в две колонки, карточки — обычным списком.
   Тулбар: «Показать» (фильтр видов на клиенте по data-kind; в DDL — только
   лекции и семинары), счётчик «N занятий», День/Неделя, стрелки ±1 неделя
   (окно [-4..4]) с диапазоном. Изменения недели — change-block по событиям
   ПОКАЗАННОЙ недели со status ≠ normal. Каникулы (неделя без пар) — прежнее
   пустое состояние. Строки — словарь t.<key> (Р-16), пользовательские
   строки экранируются htmlTranslate (02 §6.4). */
namespace sv = para::schedview;
const std::string bodyJson = @@.get<std::string>("bodyJson");
std::string realToday = @@.get<std::string>("realTodayIso");
if (realToday.empty()) realToday = @@.get<std::string>("todayIso");
const sv::Ctx ctx{[&](const std::string& k) { return @@.get<std::string>("t." + k); },
                  @@.get<std::string>("lang")};
const auto vstr = [&](const char* k) { return ctx.t(k); };

Json::Value root(Json::objectValue);
{
    Json::CharReaderBuilder rb;
    std::string errs;
    std::unique_ptr<Json::CharReader> reader(rb.newCharReader());
    if (!reader->parse(bodyJson.data(), bodyJson.data() + bodyJson.size(),
                       &root, &errs))
        root = Json::Value(Json::objectValue);
}
const Json::Value& events = root["events"];
const bool hasEvents = events.isArray() && events.size() > 0;
const int nEvents = hasEvents ? static_cast<int>(events.size()) : 0;
std::string from = root["from"].isString() ? root["from"].asString() : sv::mondayOf(realToday);
const long fromDays = sv::daysOf(from);
std::string to = root["to"].isString() ? root["to"].asString() : sv::ymdFromDays(fromDays + 6);
// «to» сервиса — исключающая граница или последний день: подпись — по
// понедельнику + 6 дней, чтобы диапазон всегда был «Пн–Вс».
to = sv::ymdFromDays(fromDays + 6);
const int offset = root["offset"].isInt() ? root["offset"].asInt() : 0;
// «День» из «Недели»: сегодня, если оно на показанной неделе, иначе
// понедельник показанной недели.
const long todayDays = sv::daysOf(realToday);
const std::string dayLink =
    (todayDays >= fromDays && todayDays <= fromDays + 6) ? realToday : from;

$$ << "<div id=\"schedule-segment\" class=\"schedule-week\" data-state=\""
   << (hasEvents ? "data" : "empty") << "\" data-heading=\"" << vstr("schedule.weekTitle")
   << "\" data-lead=\"" << vstr("schedule.weekLead") << "\">";
if (hasEvents)
{
    $$ << "<div class=\"lesson-filterbar\"><label for=\"lesson-kind\">"
       << vstr("schedule.filterShow") << "</label>"
       << "<select id=\"lesson-kind\" data-lesson-filter>"
       << "<option value=\"\">" << vstr("schedule.filterAll") << "</option>"
       << "<option value=\"lecture\">" << vstr("schedule.filterLectures") << "</option>"
       << "<option value=\"seminar\">" << vstr("schedule.filterSeminars") << "</option>"
       << "</select><span id=\"lesson-filter-result\" class=\"caption\" aria-live=\"polite\" data-lesson-count"
       << " data-one=\"" << vstr("plural.lessonOne") << "\" data-few=\"" << vstr("plural.lessonFew")
       << "\" data-many=\"" << vstr("plural.lessonMany") << "\">"
       << sv::countLabel(ctx, nEvents, "lesson") << "</span></div>";
}
%>
  <div class="calendar-toolbar">
    <div class="segments" role="group" aria-label="<%c++ $$ << vstr("a11y.schedulePeriod"); %>">
      <button type="button" aria-pressed="false" data-network-action
        hx-get="/schedule/segment?segment=today&amp;date=<%c++ $$ << sv::esc(dayLink); %>" hx-target="#schedule-segment"
        hx-swap="outerHTML" hx-push-url="/schedule?date=<%c++ $$ << sv::esc(dayLink); %>"
        hx-indicator="#schedule-indicator" hx-disabled-elt="this"><%c++ $$ << vstr("schedule.day"); %></button>
      <button type="button" aria-pressed="true" data-network-action
        hx-get="/schedule/segment?segment=week&amp;offset=<%c++ $$ << offset; %>"
        hx-target="#schedule-segment" hx-swap="outerHTML"
        hx-push-url="/schedule?segment=week&amp;offset=<%c++ $$ << offset; %>"
        hx-indicator="#schedule-indicator" hx-disabled-elt="this"><%c++ $$ << vstr("schedule.week"); %></button>
    </div>
    <div class="week-nav">
<%c++
// Стрелки ±1 (тап ≥44px): на границе окна [-4..4] — disabled. Свайп app.js
// ищет их по data-week-prev/next (aria-label переводится, 5.18).
const auto arrow = [&](int target, const char* attr, const char* aria, const char* path) {
    if (target < -4 || target > 4)
        $$ << "<button type=\"button\" class=\"icon-button\" " << attr
           << " disabled aria-label=\"" << vstr(aria) << "\">";
    else
        $$ << "<button type=\"button\" class=\"icon-button\" " << attr
           << " data-network-action aria-label=\"" << vstr(aria)
           << "\" hx-get=\"/schedule/segment?segment=week&amp;offset=" << target
           << "\" hx-target=\"#schedule-segment\" hx-swap=\"outerHTML\""
           << " hx-push-url=\"/schedule?segment=week&amp;offset=" << target
           << "\" hx-indicator=\"#schedule-indicator\" hx-disabled-elt=\"this\">";
    $$ << "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\""
       << path << "\"/></svg></button>";
};
arrow(offset - 1, "data-week-prev", "a11y.prevWeek", "m15 18-6-6 6-6");
$$ << "<span class=\"muted small\" data-week-range>" << sv::esc(sv::weekRange(ctx, from, to)) << "</span>";
arrow(offset + 1, "data-week-next", "a11y.nextWeek", "m9 18 6-6-6-6");
%>
    </div>
  </div>
<%c++
if (hasEvents)
{
    $$ << "<div class=\"week-note\"><span class=\"calendar-month\">"
       << sv::esc(sv::monthTitle(ctx, from, to)) << "</span><span class=\"caption\">"
       << vstr("schedule.weekNoteMap") << "</span></div>";
    $$ << "<div class=\"week-columns week-board\">";
    // Ось времени: пустая ячейка над часами (часовой пояс в данных не
    // определён — «GMT+3» эталона не утверждаем), метки 09:00…18:00.
    $$ << "<div class=\"calendar-axis\" aria-hidden=\"true\"><span class=\"axis-head\"></span>";
    for (int h = 9; h <= 18; ++h)
        $$ << "<span>" << sv::twoDigit(h) << ":00</span>";
    $$ << "</div>";
    for (int i = 0; i < 7; ++i)
    {
        const std::string day = sv::ymdFromDays(fromDays + i);
        int y = 0, m = 0, d = 0;
        sv::splitYmd(day, y, m, d);
        const bool isToday = day == realToday;
        $$ << "<section class=\"day-group" << (isToday ? " is-today today-column" : "")
           << "\"><div class=\"section-title\"><h2><span class=\"sr-only\">"
           << sv::esc(sv::dayTitle(ctx, day)) << "</span><span aria-hidden=\"true\">"
           << sv::weekdayShort(ctx, i) << "</span><strong aria-hidden=\"true\">" << d
           << "</strong></h2>";
        if (isToday)
            $$ << "<span class=\"badge info\">" << vstr("nav.today") << "</span>";
        $$ << "</div><div class=\"schedule-list\">";
        int n = 0;
        for (const auto& e : events)
        {
            if (sv::dateOf(sv::str(e, "starts_at")) != day)
                continue;
            ++n;
            $$ << sv::lessonCard(ctx, e, true);
        }
        if (n == 0)
            $$ << "<p class=\"muted small empty week-empty\">" << vstr("schedule.freeDay")
               << "</p>";
        $$ << "</div></section>";
    }
    $$ << "</div>";
    // Изменения ПОКАЗАННОЙ недели — блоки эталона под сеткой.
    std::string blocks;
    int nChanges = 0;
    for (const auto& e : events)
    {
        const std::string b = sv::changeBlock(ctx, e, true);
        if (!b.empty())
        {
            blocks += b;
            ++nChanges;
        }
    }
    if (nChanges > 0)
        $$ << "<section class=\"week-changes\" aria-labelledby=\"changes-title\">"
           << "<div class=\"section-title\"><h2 id=\"changes-title\">"
           << vstr("schedule.changesTitle") << "</h2><span class=\"caption\">"
           << sv::countLabel(ctx, nChanges, "change") << "</span></div>"
           << blocks << "</section>";
}
else
{
    // Каникулы / нет расписания на неделю (schedule-states.html#empty).
    $$ << "<div class=\"empty\"><div class=\"empty-icon\">"
          "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">"
          "<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/>"
          "<path d=\"M16 3v4M8 3v4M3 11h18m-5.5 2.5-5 5m0-5 5 5\"/></svg>"
          "</div><h2>" << vstr("schedule.holidayTitle") << "</h2>"
          "<p>" << vstr("schedule.holidayText") << "</p></div>";
}
%>
  <a class="button full section" href="/profile#calendar"><%c++ $$ << vstr("schedule.addWeekToCalendar"); %></a>
<%c++ $$ << "</div>"; %>
