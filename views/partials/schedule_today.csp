<%inc
#include <json/json.h>
#include <memory>
#include <string>
#include "utils/ScheduleView.h"
%>
<%c++
/* Пара · сегмент «День» расписания (Э7; дизайн v3 — design-drafts/v3/pages/
   schedule.html, schedule-change.html, schedule-states.html; fe_rebuild шаг 3).
   Рендерится страницей views/schedule.csp (SSR) и возвращается контроллером
   как ОТВЕТ htmx на GET /schedule/segment?segment=today[&date=…]
   (HX-Request: true) — корень #schedule-segment (data-state="data|empty",
   data-heading/data-lead — заголовок страницы для app.js) при outerHTML-обмене
   приезжает свежим; имя класса — schedule_today (дефис drogon_ctl 1.9.14 в
   имя класса не допускает).
   Данные — view-строки контроллера: bodyJson — ответ ScheduleService::today
   или dayBody на дату deep_link (SQL в шаблоне нет, AGENTS §5.5); todayIso —
   ПОКАЗАННЫЙ день, realTodayIso — реальное сегодня UTC проекта.
   calendar-side: месяц, диапазон недели, «Дата занятия» (input[type=date],
   окно ±4 недели — как offset недели), пилюли дней — ссылки
   /schedule?date=… (htmx-обмен сегмента + push URL); aria-current="date" —
   выбранный день, точка «сегодня» — реальный.
   calendar-agenda: карточки пар и блоки изменений — общая вёрстка
   src/utils/ScheduleView.h (div.lesson с кнопкой .lesson-open для диалога,
   аудитория — ссылка /map?q=, корпус — поле building; change-block «было →
   стало» сразу после изменённой пары, «Подробнее» открывает диалог пары).
   Пустой день — .empty эталона (иконка, «Свободный день», подсказка,
   «Выбрать день» → фокус в поле даты). Строки — словарь t.<key> (Р-16),
   пользовательские строки экранируются htmlTranslate (02 §6.4). */
namespace sv = para::schedview;
const std::string bodyJson = @@.get<std::string>("bodyJson");
const std::string dayIso = @@.get<std::string>("todayIso");
std::string realToday = @@.get<std::string>("realTodayIso");
if (realToday.empty()) realToday = dayIso;
const sv::Ctx ctx{[&](const std::string& k) { return @@.get<std::string>("t." + k); },
                  @@.get<std::string>("lang")};
const auto vstr = [&](const char* k) { return ctx.t(k); };

Json::Value root(Json::objectValue);
{
    Json::CharReaderBuilder rb;
    std::string errs;
    std::unique_ptr<Json::CharReader> reader(rb.newCharReader());
    if (!reader->parse(bodyJson.data(), bodyJson.data() + bodyJson.size(),
                       &root, &errs))
        root = Json::Value(Json::objectValue);  // пустой день, не падение
}
const Json::Value& events = root["events"];
const bool hasEvents = events.isArray() && events.size() > 0;

int dY = 0, dM = 0, dD = 0;
const bool dayOk = sv::splitYmd(dayIso, dY, dM, dD);
const std::string monday = sv::mondayOf(dayIso);
const long mondayDays = sv::daysOf(monday);
const std::string sunday = sv::ymdFromDays(mondayDays + 6);
// Окно поля даты — недели offset −4…+4 от текущей (как стрелки «Недели»).
const long realMonday = sv::daysOf(sv::mondayOf(realToday));
const std::string minDate = sv::ymdFromDays(realMonday - 28);
const std::string maxDate = sv::ymdFromDays(realMonday + 34);
const std::string dayQ = sv::esc(dayIso);

$$ << "<div id=\"schedule-segment\" class=\"calendar-layout\" data-state=\""
   << (hasEvents ? "data" : "empty") << "\" data-heading=\"" << vstr("nav.schedule")
   << "\" data-lead=\"" << vstr("schedule.subtitle") << "\">";
%>
  <aside class="calendar-side" aria-label="<%c++ $$ << vstr("schedule.pickDay"); %>">
<%c++
if (dayOk)
    $$ << "<p class=\"calendar-month\">" << vstr(("monthNom." + sv::twoDigit(dM)).c_str())
       << " <span>" << dY << "</span></p>";
$$ << "<p class=\"caption\">" << vstr("schedule.weekStrip") << " "
   << sv::esc(sv::weekRange(ctx, monday, sunday)) << "</p>";
%>
<%c++
      /* Дата на «кнопке»: нативное поле рисует значение в локали ОС
         («11/22/2026» / «22 нояб. 2026 г.» — фикс 22.11), поэтому поверх
         прозрачного инпута — своя надпись в дд.мм.гггг (dayQ — esc-нутая
         строка YYYY-MM-DD). */
      const std::string dayView = dayQ.size() == 10
          ? dayQ.substr(8, 2) + "." + dayQ.substr(5, 2) + "." + dayQ.substr(0, 4)
          : dayQ;
%>
    <div><label class="caption" for="schedule-date"><%c++ $$ << vstr("schedule.dateLabel"); %></label><span class="date-field"><input id="schedule-date" name="date" type="date" required data-schedule-date data-network-action min="<%c++ $$ << minDate; %>" max="<%c++ $$ << maxDate; %>" value="<%c++ $$ << dayQ; %>" data-invalid-message="<%c++ $$ << vstr("schedule.dateInvalid"); %>"><span class="date-field-view" data-date-view aria-hidden="true"><%c++ $$ << dayView; %></span></span></div>
<%c++ if (dayOk) { %>
    <div class="week-strip" aria-label="<%c++ $$ << vstr("schedule.weekStrip"); %>">
<%c++
for (int i = 0; i < 7; ++i)
{
    const std::string ymd = sv::ymdFromDays(mondayDays + i);
    int y = 0, m = 0, d = 0;
    sv::splitYmd(ymd, y, m, d);
    $$ << "<a class=\"day-pill\" href=\"/schedule?date=" << ymd << "\""
       << " hx-get=\"/schedule/segment?segment=today&amp;date=" << ymd << "\""
       << " hx-target=\"#schedule-segment\" hx-swap=\"outerHTML\""
       << " hx-push-url=\"/schedule?date=" << ymd << "\""
       << " hx-indicator=\"#schedule-indicator\""
       << (ymd == dayIso ? " aria-current=\"date\"" : "") << ">"
       << "<span aria-hidden=\"true\">" << sv::weekdayShort(ctx, i) << "</span>"
       << "<strong aria-hidden=\"true\">" << d << "</strong>"
       << "<span class=\"sr-only\">" << sv::esc(sv::dayTitle(ctx, ymd))
       << (ymd == realToday ? " · " + vstr("nav.today") : std::string()) << "</span>"
       << (ymd == realToday ? "<span class=\"today-dot\" aria-hidden=\"true\"></span>" : "")
       << "</a>";
} %>
    </div>
<%c++ } %>
    <div class="calendar-key"><span><i></i><%c++ $$ << vstr("schedule.keyLesson"); %></span><span class="red"><i></i><%c++ $$ << vstr("schedule.keyChange"); %></span></div>
    <a class="button ghost full" href="/profile#calendar"><%c++ $$ << vstr("profile.icsAdd"); %></a>
  </aside>
  <section class="calendar-agenda" aria-label="<%c++ $$ << vstr("schedule.agenda"); %>">
  <div class="calendar-toolbar">
    <div class="segments" role="group" aria-label="<%c++ $$ << vstr("a11y.schedulePeriod"); %>">
      <button type="button" aria-pressed="true" data-network-action
        hx-get="/schedule/segment?segment=today&amp;date=<%c++ $$ << dayQ; %>" hx-target="#schedule-segment"
        hx-swap="outerHTML" hx-push-url="/schedule?date=<%c++ $$ << dayQ; %>"
        hx-indicator="#schedule-indicator" hx-disabled-elt="this"><%c++ $$ << vstr("schedule.day"); %></button>
      <button type="button" aria-pressed="false" data-network-action
        hx-get="/schedule/segment?segment=week&amp;date=<%c++ $$ << dayQ; %>"
        hx-target="#schedule-segment" hx-swap="outerHTML"
        hx-push-url="/schedule?segment=week&amp;date=<%c++ $$ << dayQ; %>"
        hx-indicator="#schedule-indicator" hx-disabled-elt="this"><%c++ $$ << vstr("schedule.week"); %></button>
    </div>
  </div>
  <div class="section-title">
    <h2 id="day-title"><%c++ $$ << sv::esc(sv::dayTitle(ctx, dayIso)); %></h2>
    <span class="caption" id="day-count"><%c++
if (hasEvents)
    $$ << sv::countLabel(ctx, static_cast<int>(events.size()), "lesson");
else
    $$ << vstr("schedule.noClasses");
    %></span>
  </div>
  <div class="schedule-list" id="day-lessons">
<%c++
if (!hasEvents)
{
    // Пустой день (schedule-states.html#empty / schedule.html renderDay).
    $$ << "<div class=\"empty\"><div class=\"empty-icon\">"
          "<svg class=\"icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">"
          "<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/>"
          "<path d=\"M16 3v4M8 3v4M3 11h18M8 15h1M15 15h1\"/></svg></div>"
          "<h2>" << vstr("schedule.freeDayTitle") << "</h2>"
          "<p>" << vstr("schedule.freeDayHint") << "</p>"
          "<a class=\"button\" href=\"#schedule-date\" data-focus-date>"
       << vstr("schedule.pickDayAction") << "</a></div>";
}
else
{
    for (const auto& e : events)
    {
        $$ << sv::lessonCard(ctx, e, false);
        $$ << sv::changeBlock(ctx, e, false);
    }
}
%>
  </div>
  <div class="actions section">
    <a class="button" href="/profile#calendar"><%c++ $$ << vstr("profile.icsAdd"); %></a>
    <a class="button ghost" href="/rooms"><%c++ $$ << vstr("schedule.findRoom"); %></a>
  </div>
  </section>
<%c++ $$ << "</div>"; %>
