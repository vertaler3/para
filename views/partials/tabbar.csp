<%c++
/* Пара · нижний фиксированный таб-бар: пять равных пунктов (20% ширины),
   bg --surface, бордер сверху --border, снизу env(safe-area-inset-bottom).
   Фактическая высота ~64px (.nav-link min-height 52px + padding полосы
   6px) — реализация брифа html-дорожки; спека 03 §3.2 «56px» — до
   синхронизации 03 (пивот палитры/оболочки — Р-16 в docs/decisions.md).
   На ≥1024px app.css переводит .primary-nav в горизонтальную строку
   навигации под шапкой (решение брифа — не сайдбар 03 §3.5); DOM один
   на всех ширинах.
   Активный таб — view-переменная activeTab (today|schedule|grades|
   applications|profile), страница задаёт её в рендер-вызове до рендера
   шаблона; активному пункту проставляется aria-current="page" (03 §3.2),
   цвет активного состояния — токен --primary через .nav-link[aria-current].
   Иконки — упрощённые inline-SVG из черновиков (по мотивам Lucide:
   layout-grid, calendar-days, graduation-cap, file-text, user; это НЕ
   точный набор 03 §2.7 — там для «Сегодня» назван layout-dashboard),
   цвет — currentColor.
   5.18 (шаг 3): подписи табов и aria — словарь t.<key> из view-данных
   (Р-16: строки кладёт контроллер до рендера, insertUiStrings). */
const std::string activeTab = @@.get<std::string>("activeTab");
%>
<nav class="primary-nav" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.primaryNav"); %>">
  <a class="nav-link" href="/"<%c++ if(activeTab=="today") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.today"); %></span></a>
  <a class="nav-link" href="/schedule"<%c++ if(activeTab=="schedule") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h1M15 15h1"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.schedule"); %></span></a>
  <a class="nav-link" href="/grades"<%c++ if(activeTab=="grades") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5-10-5Zm4 3v5c4 3 8 3 12 0v-5M22 9v8"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.grades"); %></span></a>
  <a class="nav-link" href="/applications"<%c++ if(activeTab=="applications") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.applications"); %></span></a>
  <a class="nav-link" href="/profile"<%c++ if(activeTab=="profile") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.profile"); %></span></a>
</nav>
