<%c++
/* Пара · каркас v3 (fe_rebuild шаг 4, Р-31): skip-link + site-header + офлайн-баннер.
   Разметка — эталон design-drafts/v3/pages/dashboard.html: вордмарк-SVG «пара»
   (как логотип — не переводится), primary-nav (5 разделов; на <1024px — нижний
   таб-бар, ≥1024px — строка в шапке, ≥1100px — navy-сайдбар: всё делает CSS
   эталона, DOM один), workspace-label, header-actions (дата недели — app.js
   [data-header-date] через Intl по <html lang>; колокольчик с бейджем — app.js
   по GET /v1/notifications?unread=1; аватар — инициалы из GET /v1/me), campus-nav
   «В кампусе» (≥1100px; активный пункт — app.js по location.pathname).
   Подпись сайдбара «Моё пространство» — data-heading из словаря (в CSS эталона
   она была зашита по-русски — Р-31(д)). Строки — t.<key> из view-данных
   (Р-16: insertUiStrings ДО рендера). Вход сотрудника (staffEntry="1" — роль ИЗ
   СЕССИИ сервера, DashboardCtrl/StaffCtrl) — staff-label + staff-nav, как раньше.
   Бывший partials/tabbar.csp — пустой совместимый партиал (primary-nav теперь здесь). */
const std::string activeTab = @@.get<std::string>("activeTab");
const std::string staffEntry = @@.get<std::string>("staffEntry");
%>
<a class="skip" href="#main"><%c++ $$ << @@.get<std::string>("t.a11y.skipToContent"); %></a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.brandHome"); %>"><svg aria-hidden="true" class="para-wordmark" fill="none" focusable="false" viewBox="0 0 306 120" xmlns="http://www.w3.org/2000/svg">
<g aria-hidden="true" class="para-wordmark__guides" opacity=".38" stroke="currentColor" stroke-width=".75">
<path d="M10 27H296M10 88H296M20 14V112M89 14V101M104 14V101M160 14V101M177 14V101M226 14V101M242 14V101M291 14V101" stroke-dasharray="2 5"></path>
<path d="M40 22H75M33 57V76M53 93H76M104 57V77M114 23H147M179 32H211M235 22H275M237 57V76"></path>
</g>
<g class="para-wordmark__letters" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round" stroke-width="7">
<path d="M22 108V29M23 57C23 17 85 17 85 57S23 97 23 57Z"></path>
<path d="M157 30V87M157 57C157 17 103 17 103 57S157 97 157 57Z"></path>
<path d="M181 87V29M181 55C181 34 196 26 215 30"></path>
<path d="M288 30V87M288 57C288 17 234 17 234 57S288 97 288 57Z"></path>
</g>
<g aria-hidden="true" class="para-wordmark__nodes" stroke="currentColor" stroke-width="1.2">
<rect height="6" width="6" x="19" y="26"></rect><rect height="6" width="6" x="19" y="105"></rect>
<circle cx="54" cy="27" r="2.8"></circle><circle cx="85" cy="57" r="2.8"></circle><circle cx="54" cy="87" r="2.8"></circle>
<circle cx="103" cy="57" r="2.8"></circle><circle cx="130" cy="27" r="2.8"></circle><rect height="6" width="6" x="154" y="84"></rect>
<rect height="6" width="6" x="178" y="26"></rect><circle cx="215" cy="30" r="2.8"></circle>
<circle cx="234" cy="57" r="2.8"></circle><circle cx="261" cy="27" r="2.8"></circle><rect height="6" width="6" x="285" y="84"></rect>
</g>
</svg></a>
    <nav class="primary-nav" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.primaryNav"); %>" data-heading="<%c++ $$ << @@.get<std::string>("t.shell.workspace"); %>">
    <a class="nav-link" data-nav="today" href="/"<%c++ if(activeTab=="today") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.today"); %></span></a>
    <a class="nav-link" data-nav="schedule" href="/schedule"<%c++ if(activeTab=="schedule") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h1M15 15h1"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.schedule"); %></span></a>
    <a class="nav-link" data-nav="grades" href="/grades"<%c++ if(activeTab=="grades") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5-10-5Zm4 3v5c4 3 8 3 12 0v-5M22 9v8"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.grades"); %></span></a>
    <a class="nav-link" data-nav="applications" href="/applications"<%c++ if(activeTab=="applications") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.applications"); %></span></a>
    <a class="nav-link" data-nav="profile" href="/profile"<%c++ if(activeTab=="profile") $$ << " aria-current=\"page\""; %>><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span><%c++ $$ << @@.get<std::string>("t.nav.profile"); %></span></a>
    </nav>
<%c++ if (staffEntry == "1") { %>
    <span class="staff-label"><%c++ $$ << @@.get<std::string>("t.staff.office"); %></span>
    <nav class="staff-nav" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.staffNav"); %>" data-heading="<%c++ $$ << @@.get<std::string>("t.staff.office"); %>"><a href="/staff"<%c++ if(activeTab=="staff") $$ << " aria-current=\"page\""; %>><%c++ $$ << @@.get<std::string>("t.staff.desk"); %></a></nav>
<%c++ } %>
    <div class="workspace-label"><span><%c++ $$ << @@.get<std::string>("t.shell.workspace"); %></span><span class="workspace-period"><%c++ $$ << @@.get<std::string>("t.shell.semester"); %></span></div>
    <div class="header-actions">
      <span class="header-date" data-header-date></span>
      <a class="icon-button" href="/notifications" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.notifications"); %>">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
        <span class="notification-count" data-unread-badge hidden></span>
      </a>
      <a class="avatar" href="/profile" data-avatar aria-label="<%c++ $$ << @@.get<std::string>("t.common.openProfile"); %>"></a>
    </div>
    <nav class="campus-nav" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.campusNav"); %>">
      <p><%c++ $$ << @@.get<std::string>("t.campus.title"); %></p>
      <a href="/library" data-campus-link><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h7a2 2 0 0 1 2 2v15a3 3 0 0 0-3-2H3V4Zm18 0h-7a2 2 0 0 0-2 2v15a3 3 0 0 1 3-2h6V4Z"/></svg><span><%c++ $$ << @@.get<std::string>("t.campus.library"); %></span></a>
      <a href="/canteens" data-campus-link><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3v7a3 3 0 0 0 6 0V3M7 3v18M20 3c-4 2-5 5-5 9h5V3Zm0 9v9"/></svg><span><%c++ $$ << @@.get<std::string>("t.campus.canteen"); %></span></a>
      <a href="/map" data-campus-link><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6ZM9 3v15M15 6v15"/></svg><span><%c++ $$ << @@.get<std::string>("t.campus.map"); %></span></a>
      <a href="/rooms" data-campus-link><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v16M2 21h20M14 12h1"/></svg><span><%c++ $$ << @@.get<std::string>("t.campus.rooms"); %></span></a>
      <a href="/people" data-campus-link><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20v-1a6.5 6.5 0 0 1 13 0v1M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 5.5V20"/></svg><span><%c++ $$ << @@.get<std::string>("t.profile.people"); %></span></a>
      <div class="sidebar-foot"><%c++ $$ << @@.get<std::string>("t.shell.sidebarFoot"); %><br><span><%c++ $$ << @@.get<std::string>("t.shell.tagline"); %></span></div>
    </nav>
  </div>
</header>
<div id="offline-banner" class="offline-banner" role="status" hidden><span data-offline-text><%c++ $$ << @@.get<std::string>("t.offline.banner"); %></span> <button type="button" class="offline-retry" data-offline-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button></div>
