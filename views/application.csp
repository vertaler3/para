<%inc
#include <json/json.h>
#include <map>
#include <memory>
#include <set>
#include <string>
%>
<%c++
/* Карточка заявки (Э7, экран «Заявки»; 03 §4.5.5, design-drafts/
   application-timeline.html). SSR: тело — ApplicationsService::one (ТОТ ЖЕ
   метод, что за JSON GET /v1/applications/{id}, вызов ПОСЛЕ Own-вердикта
   OwnershipGuard — решение в шапке ApplicationsCtrl.h; SQL в шаблоне нет,
   AGENTS §5.5), приходит сериализованной строкой bodyJson; разбор здесь,
   пользовательские строки (тип, комментарии) выводит
   HttpViewData::htmlTranslate (02 §6.4, Р-16).
   Режимы (view-переменная mode от контроллера):
     data    — своя заявка: шапка (тип + бейдж статуса), таймлайн,
               детали payload, ветка «Требуется уточнение» (С7.6) и
               «Скачать PDF» на ready|issued;
     guard   — 403 (чужая) / 404 (несуществующая): ОДНА нейтральная
               карточка «Не нашли то, что искали» — текст не различает
               чужое/несуществующее (03 §5.3:1017/1021), коды статуса
               различаются на ответе (DoD 01 п.2) — это HTML-страница,
               НЕ голый JSON;
     dberror — сбой БД (500, fail-closed): «Сервис не отвечает» /
               «Мы уже знаем и чиним. Попробуйте через минуту» /
               «Повторить» ([data-app-retry] — app.js, 03 §5.3:1013).
   Таймлайн (03 §4.5.5: «таймлайн full: 5 точек с подписями и временем»):
   события application_events (порядок записи at,id) рендерятся
   хронологически одним списком:
     канонические стадии (submitted/accepted/in_progress/ready/issued —
       слова 01 §4.4) — li done, а стадия, совпадающая с ТЕКУЩИМ статусом
       заявки, — li current (кольцо primary-soft);
     need_info — li warn (точка warning, вопрос деканата текстом);
     rejected/cancelled — li stop (красная точка, причина текстом;
       «таймлайн останавливается на красной точке», 03 §4.5.5:650);
     сообщение мини-диалога (from==to) — li «Сообщение» с текстом.
   Несостоявшиеся стадии: после событий добавляются future-пункты
   (подпись «—»), КРОМЕ терминальных статусов — там таймлайн остановлен.
   Ветка С7.6 (03 §4.5.5, 03 §5.5): статус need_info — блок ответа
   (notice.warn: вопрос = комментарий последнего need_info-события +
   textarea + «Ответить»); app.js POST /{id}/messages → 201 c
   application_status=="in_progress" → бейдж «В работе», событие в
   таймлайн (данные только textContent, 02 §6.4).
   PDF (03 §4.5.5): статус ready|issued — «Скачать PDF»
   (/v1/applications/{id}/pdf, штамп «ДЕМО · вымышленные данные», 5.3 из
   01); 409 not_ready → inline «Справка ещё не готова» у кнопки (app.js,
   03 §5). Кнопка отрисовывается сервером по статусу (у не-готовой
   заявки её нет).
   v3 (fe_rebuild шаг 14, application-success/-timeline/-document.html):
   body.document-flow; ?submitted=1 (редирект формы после подачи) —
   блок «Заявка отправлена» эталона над таймлайном; h2#application-number
   — витринный номер (формула applications.csp) рядом с бейджем;
   #application-owner — ФИО · группа из профиля (контроллер:
   UserService::loadProfile → profileJson); aria-current="step" у
   текущей стадии; черновик — «Продолжить заполнение» →
   /applications/new?type=&draft=; детали — dl.detail-list; уточнение —
   <form> с ответом и .notice.success «Ответ отправлен»; ready|issued —
   HTML-превью справки (поля PdfBuilder::CertificateData, водяной знак
   «ДЕМО · вымышленные данные») + «Скачать PDF» и «Печать / сохранить
   в PDF» (window.print, CSS печати — только превью). Весь текст — ключи
   словаря ×3 (данные БД — как есть).
   Скелетона нет — страница целиком SSR (03 §5.1, прецедент grades.csp);
   офлайн — баннер каркаса (03 §5.4). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js — сама страница
     (defer, локальный путь — AGENTS: без npm/CDN). -->
<script defer src="/static/js/app.js"></script>
<body class="document-flow" data-page="application">
<%view topbar %>
<main id="main" class="shell">
<%c++
const std::string mode = @@.get<std::string>("mode");
const std::string uiLang = @@.get<std::string>("lang");
const auto esc = [](const std::string& s) {
    return HttpViewData::htmlTranslate(s);
};
const auto vstr = [&](const char* key) {
    return @@.get<std::string>(std::string("t.") + key);
};
const auto sp = [&uiLang]() { return std::string(uiLang == "zh" ? "" : " "); };
// «2026-11-02T14:05:00Z» → «2 ноября» / «2 November» / «11月2日»
const auto dayMonthOf = [&](const std::string& iso) -> std::string {
    if (iso.size() < 10) return "";
    int d = 0, m = 0;
    try { d = std::stoi(iso.substr(8, 2)); m = std::stoi(iso.substr(5, 2)); }
    catch (...) { return ""; }
    if (m < 1 || m > 12) return "";
    if (uiLang == "zh") return std::to_string(m) + "月" + std::to_string(d) + "日";
    return std::to_string(d) + " " +
           vstr((std::string("month.") + (m < 10 ? "0" : "") + std::to_string(m)).c_str());
};
const auto stampOf = [&](const std::string& iso) -> std::string {
    const std::string dm = dayMonthOf(iso);
    if (dm.empty() || iso.size() < 16) return dm;
    return dm + ", " + iso.substr(11, 5);
};
const auto statusTitle = [&](const std::string& s) -> std::string {
    if (s == "draft") return vstr("apps.statusDraft");
    if (s == "submitted") return vstr("apps.statusSubmitted");
    if (s == "accepted") return vstr("apps.statusAccepted");
    if (s == "in_progress") return vstr("apps.statusInProgress");
    if (s == "need_info") return vstr("apps.statusNeedInfo");
    if (s == "ready") return vstr("apps.statusReady");
    if (s == "issued") return vstr("apps.statusIssued");
    if (s == "rejected") return vstr("apps.statusRejected");
    if (s == "cancelled") return vstr("apps.statusCancelled");
    return s;
};
const auto doneStages = [](const std::string& s) -> int {
    if (s == "submitted") return 1;
    if (s == "accepted") return 2;
    if (s == "in_progress" || s == "need_info") return 3;
    if (s == "ready") return 4;
    if (s == "issued") return 5;
    return 0;
};
std::string heading = vstr("apps.cardTitle");
Json::Value card(Json::objectValue);
Json::Value timeline(Json::arrayValue);
Json::Value profile(Json::objectValue);
bool dataOk = false;
if (mode == "data")
{
    Json::CharReaderBuilder rb;
    std::string errs;
    std::unique_ptr<Json::CharReader> reader(rb.newCharReader());
    const std::string bodyJson = @@.get<std::string>("bodyJson");
    dataOk = !bodyJson.empty() &&
             reader->parse(bodyJson.data(), bodyJson.data() + bodyJson.size(),
                           &card, &errs) &&
             card.isMember("type_title");
    if (dataOk && card.isMember("timeline") && card["timeline"].isArray())
        timeline = card["timeline"];
    if (dataOk)
        heading = card["type_title"].asString();
    const std::string profileJson = @@.get<std::string>("profileJson");
    Json::Value pr;
    if (!profileJson.empty() &&
        reader->parse(profileJson.data(), profileJson.data() + profileJson.size(),
                      &pr, &errs) && pr.isObject())
        profile = pr;
}
%>
  <div class="page-heading">
    <div>
      <a class="back" href="/applications"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << esc(vstr("common.back")); %></a>
      <h1><%c++ $$ << esc(heading); %></h1>
<%c++
if (mode == "data" && dataOk)
    $$ << "<p>" << esc(vstr("apps.from")) << sp()
       << esc(dayMonthOf(card["created_at"].asString())) << "</p>";
%>
    </div>
  </div>
<%c++
if (mode == "guard")
{
    // 403/404: одна нейтральная карточка (03 §5.3:1017), коды различаются
%>
  <div class="content-form">
    <div class="surface">
      <div class="empty">
        <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6M8 13h8M8 17h5"/></svg></div>
        <h2><%c++ $$ << esc(vstr("apps.notFoundTitle")); %></h2>
        <p><%c++ $$ << esc(vstr("apps.notFoundText")); %></p>
        <div class="actions">
          <a class="button" href="/"><%c++ $$ << esc(vstr("common.toHome")); %></a>
          <a class="button" href="/applications"><%c++ $$ << esc(vstr("apps.title")); %></a>
        </div>
      </div>
    </div>
  </div>
<%c++
}
else if (mode == "dberror" || (mode == "data" && !dataOk))
{
%>
  <div class="content-form">
    <section class="section flow" role="alert">
      <h3><%c++ $$ << esc(vstr("apps.svcDownTitle")); %></h3>
      <p class="muted"><%c++ $$ << esc(vstr("apps.svcDownText")); %></p>
      <button class="button" type="button" data-app-retry><%c++ $$ << esc(vstr("common.retry")); %></button>
    </section>
  </div>
<%c++
}
else
{
    const std::string status = card["status"].asString();
    const std::string badgeClass =
        status == "submitted" || status == "accepted" || status == "in_progress"
            ? "info"
        : status == "need_info" ? "warn"
        : status == "ready" || status == "issued" ? "success"
        : status == "rejected" || status == "cancelled" ? "danger"
        : status == "draft" ? "outline" : "";
    static const char* kCanonical[] = {"submitted", "accepted", "in_progress",
                                       "ready", "issued"};
    const auto isCanonical = [](const std::string& s) {
        for (const char* c : kCanonical)
            if (s == c) return true;
        return false;
    };
    std::string needInfoQuestion;
    std::string readyAt;
    for (const auto& e : timeline)
    {
        const std::string to = e["to_status"].asString();
        if (to == "need_info" && e["comment"].isString())
            needInfoQuestion = e["comment"].asString();
        if (to == "ready" && e["at"].isString())
            readyAt = e["at"].asString();
    }
    if (readyAt.empty()) readyAt = card["updated_at"].asString();
    const bool isNeedInfo = status == "need_info";
    const bool canPdf = status == "ready" || status == "issued";
    const bool terminal = status == "rejected" || status == "cancelled";
    const bool isDraft = status == "draft";
    const bool submitted = @@.get<std::string>("submitted") == "1" && !isDraft;
    const int64_t appId = card["id"].asInt64();
    // Витринный номер — формула applications.csp (шапка шаблона)
    std::string idStr = std::to_string(appId);
    while (idStr.size() < 4) idStr = "0" + idStr;
    const std::string created = card["created_at"].asString();
    const std::string number = vstr("apps.numberPrefix") + "-" +
        (created.size() >= 4 ? created.substr(0, 4) : "") + "-" + idStr;
    const std::string fio = profile.get("fio", "").asString();
    const std::string group = profile.get("group", "").asString();
    const auto miniProgress = [&](int done) {
        $$ << "<div class=\"mini-progress\" aria-label=\""
           << esc(vstr("apps.stagesPrefix")) << sp() << done << sp()
           << esc(vstr("apps.stagesTotal")) << "\">";
        for (int i = 0; i < 5; ++i)
            $$ << "<span" << (i < done ? " class=\"done\"" : "") << "></span>";
        $$ << "</div>";
    };
    if (submitted)
    {
        // application-success.html: блок над таймлайном (S1 аудита)
%>
  <div class="content-form surface empty" data-submitted-block role="status">
    <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg></div>
    <h2><%c++ $$ << esc(vstr("apps.sentTitle")); %></h2>
    <p><strong><%c++ $$ << esc(vstr("apps.sentDone")); %></strong> · <span id="submitted-number"><%c++ $$ << esc(number); %></span></p>
    <p><%c++ $$ << esc(vstr("apps.sentText")); %></p>
<%c++ miniProgress(doneStages(status)); %>
    <div class="stack">
      <a class="button primary full" href="#application-number"><%c++ $$ << esc(vstr("apps.openStatus")); %></a>
      <a class="button ghost full" href="/"><%c++ $$ << esc(vstr("common.toHome")); %></a>
    </div>
  </div>
<%c++
    }
%>
  <div class="content-form">
    <div class="row wrap">
      <h2 id="application-number" tabindex="-1"><%c++ $$ << esc(number); %></h2>
      <span class="badge <%c++ $$ << badgeClass; %>" id="application-current-status" data-app-badge><%c++ $$ << esc(statusTitle(status)); %></span>
    </div>
<%c++
    if (!fio.empty())
        $$ << "<p class=\"caption section\" id=\"application-owner\">" << esc(fio)
           << (group.empty() ? "" : " · ") << esc(group) << "</p>";
    if (isDraft)
    {
        // T9 аудита: черновик продолжается в форме (Р-34)
        $$ << "<div class=\"notice section\"><p>" << esc(vstr("apps.draftNote"))
           << "</p><a class=\"button primary\" href=\"/applications/new?type="
           << esc(card["type"].asString()) << "&amp;draft=" << appId << "\">"
           << esc(vstr("apps.continueDraft")) << "</a></div>";
    }
%>
    <ol class="timeline" data-app-timeline>
<%c++
    std::set<std::string> seenStages;
    for (const auto& e : timeline)
    {
        const std::string to = e["to_status"].asString();
        const std::string from = e["from_status"].isString() ? e["from_status"].asString() : "";
        const std::string comment = e["comment"].isString() ? e["comment"].asString() : "";
        const std::string stamp = stampOf(e["at"].asString());
        std::string cls;
        std::string label;
        if (from == to && !to.empty())
            label = vstr("apps.message");
        else if (isCanonical(to))
        {
            seenStages.insert(to);
            cls = to == status ? " class=\"current\" aria-current=\"step\"" : " class=\"done\"";
            label = statusTitle(to);
        }
        else if (to == "need_info")
        {
            cls = to == status ? " class=\"warn\" aria-current=\"step\"" : " class=\"warn\"";
            label = statusTitle(to);
        }
        else if (to == "rejected" || to == "cancelled")
        {
            cls = " class=\"stop\" aria-current=\"step\"";
            label = statusTitle(to);
        }
        else
            label = statusTitle(to);
        $$ << "<li" << cls << "><strong>" << esc(label) << "</strong><p>";
        if (!stamp.empty()) $$ << esc(stamp);
        if (!comment.empty())
        {
            if (!stamp.empty()) $$ << " · ";
            $$ << esc(comment);
        }
        $$ << "</p></li>";
    }
    for (const char* c : kCanonical)
    {
        const std::string stage = c;
        if (seenStages.count(stage) || terminal)
            continue;
        if (stage == status)
            $$ << "<li class=\"current\" aria-current=\"step\"><strong>" << esc(statusTitle(stage))
               << "</strong><p>" << esc(vstr("apps.now")) << "</p></li>";
        else
            $$ << "<li class=\"future\"><strong>" << esc(statusTitle(stage))
               << "</strong><p>—</p></li>";
    }
%>
    </ol>
    <!-- С7.6 «Требуется уточнение»: форма ответа (application-timeline.html
         #clarification); POST /{id}/messages — app.js -->
    <form class="flow section" data-reply-block data-app-id="<%c++ $$ << appId; %>" novalidate<%c++ if (!isNeedInfo) $$ << " hidden"; %>>
      <p class="notice warn"><strong><%c++ $$ << esc(vstr("apps.askTitle")); %></strong><br><span data-reply-question><%c++ $$ << esc(needInfoQuestion.empty() ? vstr("apps.askFallback") : needInfoQuestion); %></span></p>
      <div class="field">
        <label for="reply"><%c++ $$ << esc(vstr("apps.yourReply")); %></label>
        <textarea id="reply" name="reply" data-reply-text rows="3" maxlength="1000" required placeholder="<%c++ $$ << esc(vstr("apps.replyPh")); %>"></textarea>
        <p class="field-error" id="reply-error" role="alert" data-reply-error hidden></p>
      </div>
      <button class="button primary full" type="submit" data-reply-send data-network-action data-offline-label="<%c++ $$ << esc(vstr("apps.offlineReply")); %>"><%c++ $$ << esc(vstr("apps.sendReply")); %></button>
    </form>
    <p class="notice success" id="reply-result" role="status" data-reply-result hidden></p>
<%c++
    const Json::Value& payload = card["payload"];
    if (payload.isObject() && payload.size() > 0)
    {
        const auto keyLabel = [&](const std::string& k) -> std::string {
            if (k == "copies") return vstr("apps.copies");
            if (k == "delivery") return vstr("apps.delivery");
            if (k == "purpose") return vstr("apps.purpose");
            if (k == "topic") return vstr("apps.topic");
            if (k == "supervisor") return vstr("apps.supervisor");
            if (k == "comment") return vstr("apps.commentLabel");
            return k;
        };
        $$ << "<section class=\"section application-details\"><h2>"
           << esc(vstr("apps.details")) << "</h2><dl class=\"detail-list\">";
        for (const auto& key : payload.getMemberNames())
        {
            const Json::Value& v = payload[key];
            $$ << "<div><dt>" << esc(keyLabel(key)) << "</dt><dd>";
            if (key == "delivery" && v.isString())
                $$ << esc(v.asString() == "office" ? vstr("apps.deliveryOffice")
                          : v.asString() == "pdf" ? vstr("apps.deliveryPdf") : v.asString());
            else if (v.isString()) $$ << esc(v.asString());
            else if (v.isIntegral()) $$ << v.asInt64();
            else if (v.isDouble()) $$ << v.asDouble();
            $$ << "</dd></div>";
        }
        $$ << "</dl></section>";
    }
    if (canPdf)
    {
        // application-document.html: HTML-превью справки — те же поля, что
        // PdfBuilder::CertificateData (тип, № и дата, статус, ФИО,
        // факультет, программа, курс/группа, студбилет). Дата — переход в
        // ready (событие), иначе updated_at. Текст «обучается … по очной
        // форме» эталона не переносится: формы обучения и рода в данных нет.
        const auto dash = [&](const std::string& v) { return v.empty() ? std::string("—") : v; };
        const std::string course = profile.isMember("course") ? profile["course"].asString() : "";
        std::string docNo = vstr("apps.docNo");
        const auto put = [](std::string& s, const std::string& k, const std::string& v) {
            const auto pos = s.find(k);
            if (pos != std::string::npos) s.replace(pos, k.size(), v);
        };
        put(docNo, "{n}", number);
        put(docNo, "{d}", dayMonthOf(readyAt) + (readyAt.size() >= 4 ? " " + readyAt.substr(0, 4) : ""));
        const bool office = payload.isObject() && payload["delivery"].isString() &&
                            payload["delivery"].asString() == "office";
%>
    <section class="section" data-document-block>
      <div class="section-title"><h2><%c++ $$ << esc(vstr(status == "issued" ? "apps.docIssued" : "apps.docReady")); %></h2></div>
<%c++ if (office) $$ << "<p class=\"caption\">" << esc(vstr("apps.pickupNote")) << "</p>"; %>
      <article class="document-paper">
        <div class="document-watermark"><%c++ $$ << esc(vstr("apps.watermark")); %></div>
        <h2><%c++ $$ << esc(heading); %></h2>
        <p id="document-number"><%c++ $$ << esc(docNo); %></p>
        <dl class="detail-list">
          <div><dt><%c++ $$ << esc(vstr("apps.docTo")); %></dt><dd id="document-person"><%c++ $$ << esc(dash(fio)); %></dd></div>
          <div><dt><%c++ $$ << esc(vstr("apps.docFaculty")); %></dt><dd><%c++ $$ << esc(dash(profile.get("faculty", "").asString())); %></dd></div>
          <div><dt><%c++ $$ << esc(vstr("apps.docProgram")); %></dt><dd><%c++ $$ << esc(dash(profile.get("program", "").asString())); %></dd></div>
          <div><dt><%c++ $$ << esc(vstr("apps.docCourseGroup")); %></dt><dd><%c++ $$ << esc(dash(course)) << " · " << esc(dash(group)); %></dd></div>
          <div><dt><%c++ $$ << esc(vstr("apps.docCard")); %></dt><dd><%c++ $$ << esc(dash(profile.get("student_card_no", "").asString())); %></dd></div>
          <div><dt><%c++ $$ << esc(vstr("apps.docStatus")); %></dt><dd><%c++ $$ << esc(statusTitle(status)); %></dd></div>
        </dl>
        <p class="section muted"><%c++ $$ << esc(vstr("apps.docFooter")); %></p>
      </article>
      <div class="actions section" data-pdf-block>
        <a class="button primary" href="/v1/applications/<%c++ $$ << appId; %>/pdf" data-pdf-link><%c++ $$ << esc(vstr("apps.downloadPdf")); %></a>
        <button class="button ghost" type="button" id="print-document" data-print-document><%c++ $$ << esc(vstr("apps.print")); %></button>
      </div>
      <p class="field-error" role="alert" data-pdf-error hidden></p>
      <p class="caption"><%c++ $$ << esc(vstr("apps.pdfStamp")); %></p>
    </section>
<%c++
    }
%>
  </div>
<%c++
}  // else (данные)
%>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
