<%c++
/* Профиль (Э7, экран 4 из 4; 03 §4.7, design-drafts/profile.html и
   profile-states.html, идеи 5.9 QR-карточка студента и 5.12 библиотека из 01).
   Страница НЕ содержит пользовательских данных: профиль (GET /v1/me),
   читательский билет (GET /v1/library/my-card; 404 — блок скрыт),
   настройки (GET/PUT /v1/notifications/settings), подписка ICS
   (POST/DELETE /v1/ics/token — GET-«что уже есть» в API нет, экран стартует
   в состоянии «нет подписки»; ротация при повторном создании — подсказка
   в блоке) и выход (POST /v1/auth/logout → /login) грузит static/js/app.js
   из JSON-роутов 02 §5.2 (паттерн views/rooms.csp). Контент строится
   только createElement/textContent — innerHTML нет (02 §6.4).
   QR — вендоренная static/vendor/qrcode-generator.js 1.5.0 (MIT — Р-21 в
   docs/decisions.md) подключается ПЕРЕД app.js (оба defer — порядок
   исполнения сохраняется); данные QR — вымышленные номера карточек
   («para-demo:{student_card_no}» / card_no, константа приложения — не
   секрет, 01 §5.9), рендер в canvas — app.js (Р-16: {{}} в v1.9.14 не
   существует; сырой вывод шаблона — только серверные константы ниже).
   Якорь #notifications — цель ссылки «Включить уведомления»
   views/notifications.csp; #calendar — цель «Подписка на календарь»
   views/schedule.csp и «В календарь» views/grades.csp (мёртвые с Э7
   ссылки оживают этим экраном).
   Состояния (03 §5): скелетон — начальная разметка до ответа; ошибка —
   своя на профиль и на настройки с «Повторить» (повторный fetch, 03 §5.3);
   офлайн — баннер каркаса (topbar + app.js applyOffline, 03 §5.4).
   Пустых состояний нет — данные профиля есть у каждого студента
   (постановка экрана).
   5.18 (шаг 3): строки экрана — словарь t.<key> из view-данных
   (ProfileCtrl::page + i18n::insertUiStrings ДО рендера, Р-16);
   автонимы языка (Рус/EN/中文) не переводятся, бейдж-дисклеймер QR —
   по-русски на всех языках (требование задания, AGENTS §5.1). */
%>
<%view head %>
<!-- app.js подключает страница; qrcode-generator — перед app.js (обе defer:
     исполнение в порядке подключения — глобальная фабрика qrcode готова). -->
<script defer src="/static/vendor/qrcode-generator.js"></script>
<script defer src="/static/js/app.js"></script>
<body data-page="profile">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <h1><%c++ $$ << @@.get<std::string>("t.profile.heading"); %></h1>
      <p><%c++ $$ << @@.get<std::string>("t.profile.subtitle"); %></p>
    </div>
  </div>
  <div>

    <!-- ==== Личные данные (GET /v1/me): скелетон → карточка | ошибка.
         v3 (profile.html): .profile-summary без карточки-подложки над
         двухколоночной .settings-grid; QR-карточки (5.9/5.12) — прод. ==== -->
    <div data-profile-loading aria-busy="true">
      <div class="skeleton title"></div>
      <div class="skeleton short"></div>
    </div>
    <section class="section flow" data-profile-error hidden role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.error.loadProfile"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
      <button class="button" type="button" data-profile-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>
    <section class="flow profile-head" data-profile-body hidden aria-labelledby="account-title">
      <div class="profile-summary">
        <div class="avatar large" data-avatar-initials aria-hidden="true"></div>
        <div>
          <h2 id="account-title" data-account-name></h2>
          <p class="muted small" data-account-meta data-student-line></p>
          <p class="small" data-student-line><%c++ $$ << @@.get<std::string>("t.profile.program"); %> <span data-account-program></span></p>
          <p class="small" data-student-line><%c++ $$ << @@.get<std::string>("t.profile.group"); %> <span data-account-group></span></p>
          <p class="caption" data-student-line><%c++ $$ << @@.get<std::string>("t.profile.cardNo"); %> <span data-account-card></span></p>
        </div>
      </div>
      <div class="actions" data-student-line>
        <button class="button" type="button" data-qr-student><%c++ $$ << @@.get<std::string>("t.profile.showQrCard"); %></button>
      </div>
      <!-- Читательский билет (5.12): GET /v1/library/my-card; нет билета
           (404 — office.demo) → блок остаётся скрытым. -->
      <div class="library-row" data-library-block hidden>
        <div>
          <strong><%c++ $$ << @@.get<std::string>("t.profile.libraryCard"); %></strong>
          <p class="muted small">№ <span data-library-card-no></span></p>
        </div>
        <button class="button" type="button" data-qr-library><%c++ $$ << @@.get<std::string>("t.profile.showQr"); %></button>
      </div>
    </section>

    <div class="settings-grid">
      <div>
        <!-- ==== «Ваш кампус» (profile.html): только живые маршруты прода —
             /rooms, /gradebook, /rating, /library, /canteens, /map,
             /people и якорь #calendar этой же страницы. ==== -->
        <section class="section" aria-labelledby="campus-title">
          <div class="section-title"><h2 id="campus-title"><%c++ $$ << @@.get<std::string>("t.profile.yourCampus"); %></h2></div>
        <a class="list-row" href="/rooms">
          <div><strong><%c++ $$ << @@.get<std::string>("t.profile.myBookings"); %></strong><p><%c++ $$ << @@.get<std::string>("t.profile.myBookingsHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="/gradebook">
          <div><strong><%c++ $$ << @@.get<std::string>("t.profile.gradebook"); %></strong><p><%c++ $$ << @@.get<std::string>("t.profile.gradebookHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="/rating">
          <div><strong><%c++ $$ << @@.get<std::string>("t.profile.rating"); %></strong><p><%c++ $$ << @@.get<std::string>("t.profile.ratingHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="/library">
          <div><strong><%c++ $$ << @@.get<std::string>("t.campus.library"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.libraryHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="/canteens">
          <div><strong><%c++ $$ << @@.get<std::string>("t.campus.canteen"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.canteenHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="/map">
          <div><strong><%c++ $$ << @@.get<std::string>("t.campus.map"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.mapHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="/people">
          <div><strong><%c++ $$ << @@.get<std::string>("t.profile.people"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.peopleHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        <a class="list-row" href="#calendar">
          <div><strong><%c++ $$ << @@.get<std::string>("t.profile.calendar"); %></strong><p><%c++ $$ << @@.get<std::string>("t.profile.calendarHint"); %></p></div>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
        </section>

        <!-- ==== Подписка на календарь (5.4; calendar.html): при загрузке
             GET /v1/ics/token (200 — активная подписка, 404 — нет);
             POST — создать/перевыпустить (ротация токена), DELETE — отозвать.
             Якорь #calendar — цель «Подписка на календарь» расписания. ==== -->
        <section class="section" id="calendar" aria-labelledby="calendar-title">
          <div class="section-title"><h2 id="calendar-title"><%c++ $$ << @@.get<std::string>("t.profile.calendar"); %></h2></div>
          <div class="surface flow ics-card" data-ics-state="<%c++ $$ << @@.get<std::string>("icsState"); %>">
            <h3><%c++ $$ << @@.get<std::string>("t.profile.icsTitle"); %></h3>
            <p class="muted small"><%c++ $$ << @@.get<std::string>("t.profile.icsHint"); %></p>
            <div data-ics-loading aria-busy="true"><div class="skeleton"></div><div class="skeleton short"></div></div>
            <div class="flow" data-ics-error hidden role="alert">
              <p class="small"><%c++ $$ << @@.get<std::string>("t.error.loadIcs"); %></p>
              <button class="button" type="button" data-ics-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
            </div>
            <div class="flow" data-ics-none hidden>
              <button class="button primary full" type="button" data-ics-create data-network-action><%c++ $$ << @@.get<std::string>("t.profile.icsCreate"); %></button>
            </div>
            <div class="flow" data-ics-active hidden>
              <p class="notice success" role="status" data-ics-status></p>
              <a class="button primary full" data-ics-webcal href="#"><%c++ $$ << @@.get<std::string>("t.profile.icsAdd"); %></a>
              <div class="field">
                <label for="ics-url"><%c++ $$ << @@.get<std::string>("t.profile.icsLinkLabel"); %></label>
                <div class="ics-link-row">
                  <input id="ics-url" type="text" readonly data-ics-url aria-describedby="ics-private">
                  <button class="button" type="button" data-ics-copy><%c++ $$ << @@.get<std::string>("t.profile.icsCopy"); %></button>
                </div>
                <span class="caption" id="ics-private"><%c++ $$ << @@.get<std::string>("t.profile.icsPrivate"); %></span>
              </div>
              <div class="actions">
                <button class="button" type="button" data-ics-create data-network-action><%c++ $$ << @@.get<std::string>("t.profile.icsReissue"); %></button>
                <button class="button danger-button" type="button" data-ics-revoke data-network-action><%c++ $$ << @@.get<std::string>("t.profile.icsRevoke"); %></button>
              </div>
            </div>
            <div class="ics-steps">
              <h4><%c++ $$ << @@.get<std::string>("t.profile.icsHowTitle"); %></h4>
              <ol class="enh-simple-list">
                <li><%c++ $$ << @@.get<std::string>("t.profile.icsStep1"); %></li>
                <li><%c++ $$ << @@.get<std::string>("t.profile.icsStep2"); %></li>
                <li><%c++ $$ << @@.get<std::string>("t.profile.icsStep3"); %></li>
              </ol>
            </div>
            <p class="caption"><%c++ $$ << @@.get<std::string>("t.profile.icsNote"); %></p>
          </div>
        </section>

        <!-- ==== Онбординг С5 (onboarding_json — массив закрытых шагов). ==== -->
        <section class="section" aria-labelledby="onboarding-title">
          <div class="section-title"><h2 id="onboarding-title"><%c++ $$ << @@.get<std::string>("t.onboarding.profileTitle"); %></h2></div>
          <section class="surface flow" data-ob-card>
            <p class="overline"><%c++ $$ << @@.get<std::string>("t.onboarding.steps"); %> · <span class="tnum" data-ob-count>0/4</span></p>
            <div class="progress ob-progress" role="progressbar" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.obProgress"); %>" data-ob-bar></div>
            <div class="ob-steps" data-ob-steps></div>
            <p class="caption" data-ob-done hidden><%c++ $$ << @@.get<std::string>("t.onboarding.done"); %></p>
          </section>
        </section>
      </div>

      <div>
        <!-- ==== Уведомления (GET/PUT /v1/notifications/settings; 03 §4.7).
             Якорь #notifications — цель «Включить уведомления» ленты.
             Тихие часы — форма эталона: подписи «с / до», строка статуса
             (aria-live) и явное сохранение PUT quiet_hours_json. ==== -->
        <section class="section" id="notifications" aria-labelledby="notifications-title">
          <div class="section-title"><h2 id="notifications-title"><%c++ $$ << @@.get<std::string>("t.notif.title"); %></h2></div>
          <div data-settings-loading aria-busy="true">
            <div class="skeleton short"></div>
            <div class="skeleton block"></div>
          </div>
          <section class="section flow" data-settings-error hidden role="alert">
            <h3><%c++ $$ << @@.get<std::string>("t.error.loadSettings"); %></h3>
            <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
            <button class="button" type="button" data-settings-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
          </section>
          <div data-settings-body hidden>
            <label class="option"><input type="checkbox" data-setting="notify_schedule"><%c++ $$ << @@.get<std::string>("t.settings.schedule"); %></label>
            <label class="option"><input type="checkbox" data-setting="notify_deadlines"><%c++ $$ << @@.get<std::string>("t.settings.deadlines"); %></label>
            <label class="option"><input type="checkbox" data-setting="notify_applications"><%c++ $$ << @@.get<std::string>("t.settings.applications"); %></label>
            <form class="enh-quiet-form" id="quiet-hours-form" data-quiet-form novalidate>
              <div class="enh-two-fields">
                <div class="field"><label for="quiet-start"><%c++ $$ << @@.get<std::string>("t.settings.quietFrom"); %></label><input id="quiet-start" name="quiet-start" type="time" required data-quiet-from></div>
                <div class="field"><label for="quiet-end"><%c++ $$ << @@.get<std::string>("t.settings.quietTo"); %></label><input id="quiet-end" name="quiet-end" type="time" required data-quiet-to></div>
              </div>
              <p class="caption"><%c++ $$ << @@.get<std::string>("t.settings.quietHint"); %></p>
              <button class="button" type="submit" data-quiet-save data-network-action><%c++ $$ << @@.get<std::string>("t.settings.quietSave"); %></button>
              <p class="caption" id="quiet-hours-status" role="status" aria-live="polite" data-quiet-status></p>
            </form>
            <p class="caption"><%c++ $$ << @@.get<std::string>("t.settings.announcementsHint"); %></p>
          </div>
        </section>

        <!-- ==== Оформление: тема и язык — прод-сегменты (Р-31); смена темы
             применяется сразу и сохраняется PUT-ом, язык — мини-роут /lang. ==== -->
        <section class="section" aria-labelledby="theme-title">
          <div class="section-title"><h2 id="theme-title"><%c++ $$ << @@.get<std::string>("t.profile.appearance"); %></h2></div>
          <div class="stack">
            <div class="segments" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.themeGroup"); %>" data-theme-group hidden>
              <button type="button" data-theme-choice="light"><%c++ $$ << @@.get<std::string>("t.profile.themeLight"); %></button>
              <button type="button" data-theme-choice="dark"><%c++ $$ << @@.get<std::string>("t.profile.themeDark"); %></button>
              <button type="button" data-theme-choice="system"><%c++ $$ << @@.get<std::string>("t.profile.themeSystem"); %></button>
            </div>
            <div class="segments" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.langGroup"); %>" data-lang-group hidden>
              <button type="button" data-lang-choice="ru">Рус</button>
              <button type="button" data-lang-choice="en">EN</button>
              <button type="button" data-lang-choice="zh">中文</button>
            </div>
          </div>
        </section>

        <!-- ==== Выход (03 §4.7: диалог с danger-подтверждением). ==== -->
        <section class="section">
          <button class="button full" type="button" data-logout-open><%c++ $$ << @@.get<std::string>("t.profile.logout"); %></button>
        </section>
      </div>
    </div>
  </div>

  <!-- QR-карточка (5.9: sheet на весь тап, QR ~240px, имя и номер под ним,
       закрытие тапом по коду или кнопкой; brightness-повышение — best-effort
       screen wake не входит в контур, постановка Э7). Данные — app.js. -->
  <dialog id="qr-dialog" class="lesson-sheet" aria-labelledby="qr-title">
    <h2 id="qr-title" data-qr-title></h2>
    <div class="qr-wrap">
      <canvas class="qr-canvas" data-qr-canvas width="280" height="280"></canvas>
    </div>
    <p class="muted small" data-qr-value></p>
    <p class="caption">концепт для хакатона, данные вымышленные</p>
    <div class="actions">
      <button class="button" type="button" data-qr-close><%c++ $$ << @@.get<std::string>("t.common.close"); %></button>
    </div>
  </dialog>

  <!-- Диалог выхода (03 §2.8/§6.4: danger-подтверждение, фокус-ловушка
       нативного <dialog>) — как отмена брони views/rooms.csp. -->
  <dialog id="logout-dialog" class="lesson-sheet" aria-labelledby="logout-title">
    <h2 id="logout-title"><%c++ $$ << @@.get<std::string>("t.profile.logoutTitle"); %></h2>
    <p><%c++ $$ << @@.get<std::string>("t.profile.logoutText"); %></p>
    <div class="actions">
      <button class="button" type="button" data-logout-close><%c++ $$ << @@.get<std::string>("t.profile.stay"); %></button>
      <button class="button danger-button" type="button" data-logout-confirm><%c++ $$ << @@.get<std::string>("t.profile.logout"); %></button>
    </div>
  </dialog>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
