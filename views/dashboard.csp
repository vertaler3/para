<%c++
/* Дашборд «Сегодня» (Э7 FE, экран 3 из 3; 03 §4.2, design-drafts/
   dashboard.html и dashboard-states.html, каркас partials Э7). Шаблон НЕ
   держит пользовательских данных: в разметке — скелетоны (начальное
   состояние до ответа), пустые тексты 03 §5.2, компактные ошибки виджетов
   03 §4.2/§5.3 и блок ошибки экрана — серверные константы; контент виджетов
   заполняет static/js/app.js из GET /v1/dashboard через textContent (без
   innerHTML — 02 §6.4). Пять состояний виджета (правки по ревью экрана):
     скелетон — в разметке, скрыт при получении данных (shimmer каркаса);
     пусто    — подписи виджетов («Пар нет — день твой» и др., 03 §5.2);
     ошибка   — [data-*-error]: компактная строка «Не получилось загрузить
                {раздел}» с «Повторить» (03 §4.2 «свой компактный
                ErrorState — сбой одного не роняет экран», 03 §5.3);
                показывается по массиву degraded из агрегата — сбой
                источника отличим от «нет данных»;
     офлайн   — баннер topbar («Нет сети…»), показывает app.js;
     экран    — [data-dashboard-error] при сетевом сбое/невалидном теле.
   Виджеты и ссылки на объект (03 §4.2): «Следующая пара» и «Сегодня» →
   /schedule (строка с переносом/отменой → /schedule?date=<день> — канон
   deep_link фикстур Э6; отдельная карточка изменения §4.9.1 — экран Э7,
   который ещё не собран, ссылка ведёт к дню с переносом); «Дедлайны» →
   /grades; «Заявки» → /applications/{id}; «Что нового» → /notifications.
   Порядок виджетов зависит от времени (03 §4.2, переставляет app.js):
     06–12 — «Следующая пара», «Сегодня», дедлайны, заявки, «Что нового»;
     12–18 — остаток «Сегодня» вверх; «Следующая пара» видима, пока есть;
     18–23 — сверху «Что сдать завтра» (пары+дедлайны завтра; пары —
             GET /v1/schedule/week?offset=0|1, дедлайны — из агрегата);
     ночь  — «За ночь: N событий» вместо «Что нового» (N — unread_count
             агрегата: накопившиеся непрочитанные; счётчики «· N» в
             заголовках «Сегодня»/«Что нового» и минутный отсчёт «Следующей
             пары» ведёт app.js).
   На ≥1024px .dashboard-grid — две колонки (колонка + aside.dashboard-side
   из app.css). «Следующая пара» после последней пары скрывается (03 §5.2).
   5.18 (шаг 3): строки каркаса и состояний — словарь t.<key> из view-данных
   (DashboardCtrl::page + i18n::insertUiStrings ДО рендера, Р-16); контент
   виджетов (дисциплины/время/счётчики) строит app.js из /v1/dashboard — его
   словарные строки (приветствие/счётчики/статусы) — через тот же словарь
   (<script id="para-i18n"> в footer, t(key, fallback) в app.js). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js подключает сама страница
     (defer, локальный путь — AGENTS: без npm/CDN; как в views/login.csp). -->
<script defer src="/static/js/app.js"></script>
<body data-page="dashboard">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <p class="eyebrow" data-today-date><%c++ $$ << @@.get<std::string>("t.nav.today"); %></p>
      <h1 class="serif"><span data-greeting><%c++ $$ << @@.get<std::string>("t.dash.greetingAfternoon"); %></span><span data-greeting-tail hidden>, <span data-account-short></span></span>.</h1>
      <p><%c++ $$ << @@.get<std::string>("t.dash.heading"); %></p>
    </div>
    <div class="greeting-note"><%c++ $$ << @@.get<std::string>("t.dash.noteLine1"); %><br><%c++ $$ << @@.get<std::string>("t.dash.noteLine2"); %></div>
  </div>
  <!-- ==== Онбординг С5 (Э7 «Профиль», 03 §4.7/§4.9.4): чеклист «4 шага»
       поверх «Сейчас важно» при незавершённом onboarding_json — показывает
       app.js (GET /v1/notifications/settings, дефолт DDL «[]», шаги
       именует FE: login/schedule/application/notifications); отметка шага
       (тап по строке) → PUT settings {onboarding_json}; все 4 или
       «Пропустить» — карточка исчезает навсегда. ==== -->
  <section class="section surface flow onboarding" data-onboarding hidden aria-labelledby="ob-title">
    <p class="overline" id="ob-title"><%c++ $$ << @@.get<std::string>("t.onboarding.title"); %> · <span class="tnum" data-ob-count>0/4</span></p>
    <div class="progress ob-progress" role="progressbar" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0" aria-label="<%c++ $$ << @@.get<std::string>("t.a11y.obProgress"); %>" data-ob-bar></div>
    <div class="ob-steps" data-ob-steps></div>
    <div class="ob-footer">
      <button class="button ghost" type="button" data-ob-skip><%c++ $$ << @@.get<std::string>("t.onboarding.skip"); %></button>
      <p class="caption"><%c++ $$ << @@.get<std::string>("t.onboarding.hint"); %></p>
    </div>
  </section>
  <!-- ==== Вход сотрудника (фикс ревью экрана «Стол сотрудника»:
       сотрудник после входа попадает на «Сегодня», и без точки входа
       /staff доступен только прямым вводом URL). Блок рендерится
       ТОЛЬКО когда DashboardCtrl::page положил view-переменную
       staffEntry="1" по роли из сессии сервера (02 §6.3); у студента
       переменной нет — блока нет, 403-карточка стола студенту не
       показывается. Дублируется ссылкой в шапке (topbar.csp). ==== -->
<%c++
if (@@.get<std::string>("staffEntry") == "1") {
%>
  <section class="section" aria-labelledby="staff-entry-title">
    <div class="surface">
      <div class="row wrap">
        <div>
          <h2 id="staff-entry-title"><%c++ $$ << @@.get<std::string>("t.staff.desk"); %></h2>
          <p class="muted small"><%c++ $$ << @@.get<std::string>("t.dash.staffDesc"); %></p>
        </div>
        <a class="button primary" href="/staff"><%c++ $$ << @@.get<std::string>("t.dash.staffOpen"); %></a>
      </div>
    </div>
  </section>
<%c++ } %>
  <div class="dashboard-grid">
    <div data-main-column>
      <!-- ==== Что сдать завтра (03 §4.2: 18:00–23:00 — сверху; пары —
           из /v1/schedule/week, дедлайны — из агрегата; строит app.js) ==== -->
      <section class="section" data-widget="tomorrow" hidden>
        <div class="section-title"><h2><%c++ $$ << @@.get<std::string>("t.dash.tomorrowTitle"); %></h2><a href="/schedule"><%c++ $$ << @@.get<std::string>("t.common.allNeut"); %> <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
        <div data-tomorrow-loading aria-hidden="true"><div class="skeleton short"></div><div class="skeleton short"></div></div>
        <div class="schedule-list" data-tomorrow-body hidden></div>
      </section>
      <!-- ==== Следующая пара → /schedule (03 §4.2); скрывается, когда пар
           больше нет (03 §5.2); отсчёт обновляется раз в минуту (app.js) ==== -->
      <section class="section" data-widget="next-class">
        <p class="overline"><%c++ $$ << @@.get<std::string>("t.dash.nextClass"); %></p>
        <div data-next-loading aria-hidden="true"><div class="skeleton block"></div></div>
        <a class="next-class" href="/schedule" data-next-body hidden>
          <div class="paper-corner" aria-hidden="true"><svg fill="none" stroke="currentColor" stroke-width="1.4" viewBox="0 0 40 40"><path d="M12 7h19v25H9V10l3-3Z"/><path d="M14 14h12M14 19h12M14 24h7"/></svg></div>
          <div class="next-top">
            <p class="next-meta"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> <span data-next-meta><%c++ $$ << @@.get<std::string>("t.dash.nextSoon"); %></span></p>
            <span class="badge outline" data-next-kind hidden></span>
          </div>
          <p class="next-time" data-next-time></p>
          <h2 data-next-discipline></h2>
          <p class="small muted next-room-line"><%c++ $$ << @@.get<std::string>("t.dash.roomLabel"); %> <span data-next-room></span></p>
        </a>
        <p class="widget-error" data-next-error hidden><%c++ $$ << @@.get<std::string>("t.error.loadSchedule"); %>. <button type="button" class="offline-retry" data-widget-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button></p>
      </section>
      <!-- ==== Сегодня → /schedule: все пары дня; счётчик «· N пар» —
           app.js; строка с переносом → /schedule?date=<день> ==== -->
      <section class="section" data-widget="today">
        <div class="section-title"><h2 data-today-title><%c++ $$ << @@.get<std::string>("t.nav.today"); %></h2><a href="/schedule"><%c++ $$ << @@.get<std::string>("t.common.allNeut"); %> <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
        <div data-today-loading aria-hidden="true"><div class="skeleton"></div><div class="skeleton short"></div><div class="skeleton"></div></div>
        <div class="schedule-list" data-today-body hidden></div>
        <p class="muted small" data-today-empty hidden><%c++ $$ << @@.get<std::string>("t.dash.emptyClasses"); %></p>
        <p class="widget-error" data-today-error hidden><%c++ $$ << @@.get<std::string>("t.error.loadSchedule"); %>. <button type="button" class="offline-retry" data-widget-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button></p>
      </section>
    </div>
    <aside class="dashboard-side" aria-label="<%c++ $$ << @@.get<std::string>("t.dash.deadlines"); %>, <%c++ $$ << @@.get<std::string>("t.nav.applications"); %>, <%c++ $$ << @@.get<std::string>("t.dash.whatsNew"); %>">
      <!-- ==== Дедлайны → /grades: ближайшие события сессии с точкой
           срочности (03 §4.2: норма --border, ≤3 дней --warning-text,
           завтра --danger-text) ==== -->
      <section class="section" data-widget="deadlines">
        <div class="section-title"><h2 class="side-title"><%c++ $$ << @@.get<std::string>("t.dash.deadlines"); %></h2><a href="/grades"><%c++ $$ << @@.get<std::string>("t.common.all"); %> <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
        <div data-deadlines-loading aria-hidden="true"><div class="skeleton short"></div><div class="skeleton short"></div></div>
        <ul class="deadline-list" data-deadlines-body hidden></ul>
        <p class="muted small" data-deadlines-empty hidden><%c++ $$ << @@.get<std::string>("t.dash.emptyDeadlines"); %></p>
        <p class="widget-error" data-deadlines-error hidden><%c++ $$ << @@.get<std::string>("t.error.loadDeadlines"); %>. <button type="button" class="offline-retry" data-widget-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button></p>
      </section>
      <!-- ==== Заявки → /applications/{id}: последние активные ==== -->
      <section class="section" data-widget="applications">
        <div class="section-title"><h2 class="side-title"><%c++ $$ << @@.get<std::string>("t.nav.applications"); %></h2><a href="/applications"><%c++ $$ << @@.get<std::string>("t.common.all"); %> <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
        <div data-applications-loading aria-hidden="true"><div class="skeleton"></div><div class="mini-progress"><span class="done"></span><span class="done"></span><span></span></div></div>
        <div data-applications-body hidden></div>
        <div class="widget-empty" data-applications-empty hidden>
          <p class="muted small"><%c++ $$ << @@.get<std::string>("t.dash.emptyApplications"); %></p>
          <a class="button ghost" href="/applications"><%c++ $$ << @@.get<std::string>("t.dash.newRequest"); %></a>
        </div>
        <p class="widget-error" data-applications-error hidden><%c++ $$ << @@.get<std::string>("t.error.loadApplications"); %>. <button type="button" class="offline-retry" data-widget-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button></p>
      </section>
      <!-- ==== Что нового → /notifications: последние уведомления;
           ночью заголовок меняется на «За ночь: N событий» (03 §4.2,
           переставляет app.js) ==== -->
      <section class="section" data-widget="news">
        <div class="section-title"><h2 class="side-title" data-news-title><%c++ $$ << @@.get<std::string>("t.dash.whatsNew"); %></h2><a href="/notifications"><%c++ $$ << @@.get<std::string>("t.common.all"); %> <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
        <div data-news-loading aria-hidden="true"><div class="skeleton"></div><div class="skeleton short"></div></div>
        <div data-news-body hidden></div>
        <p class="muted small" data-news-empty hidden><%c++ $$ << @@.get<std::string>("t.dash.emptyNews"); %></p>
        <p class="widget-error" data-news-error hidden><%c++ $$ << @@.get<std::string>("t.error.loadFeed"); %>. <button type="button" class="offline-retry" data-widget-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button></p>
      </section>
    </aside>
  </div>
  <!-- ==== В кампусе (design-drafts/dashboard.html: секция после сетки
       виджетов, перед подвалом; fix — точки входа каталогов Э6б не имели
       входа с дашборда; fix — каталог людей 5.11 входа в навигации не
       имел вовсе: в черновике карточек три, «Найти человека» — четвёртая
       той же сетки (на <600px сетка — столбец, с 600px карточка
       переносится на вторую строку сетки трёх колонок), глиф человека —
       иконка профиля из nav черновика). Серверных данных нет —
       константы разметки, view-переменные не нужны (Р-16); иконки и
       подписи — как в черновике, href — реальные маршруты страниц Э7
       (/library, /canteens, /map, /people — PeopleCtrl.h:76); цвета —
       только токены .service-link из app.css (тёмная тема —
       data-theme="dark" красит автоматически). ==== -->
  <section class="section">
    <div class="section-title"><h2><%c++ $$ << @@.get<std::string>("t.campus.title"); %></h2></div>
    <div class="service-grid">
      <a class="service-link" href="/library"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 3h7v18H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm7 0h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-9"/></svg><div><strong><%c++ $$ << @@.get<std::string>("t.campus.library"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.libraryHint"); %></p></div><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
      <a class="service-link" href="/canteens"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><strong><%c++ $$ << @@.get<std::string>("t.campus.canteen"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.canteenHint"); %></p></div><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
      <a class="service-link" href="/map"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h1M15 15h1"/></svg><div><strong><%c++ $$ << @@.get<std::string>("t.campus.map"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.mapHint"); %></p></div><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
      <a class="service-link" href="/people"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><div><strong><%c++ $$ << @@.get<std::string>("t.campus.people"); %></strong><p><%c++ $$ << @@.get<std::string>("t.campus.peopleHint"); %></p></div><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
    </div>
  </section>
  <!-- ==== Ошибка загрузки экрана (03 §5.3: «Не получилось загрузить
       {раздел}» / «Проверьте интернет — и попробуем ещё раз» / кнопка
       «Повторить»); достижима при сетевом сбое/невалидном теле — ошибки
       отдельных источников показываются компактно внутри виджетов;
       офлайн-баннер при этом показывает каркас (topbar + app.js) ==== -->
  <section class="section flow" data-dashboard-error hidden role="alert">
    <h3><%c++ $$ << @@.get<std::string>("t.error.loadToday"); %></h3>
    <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
    <button class="button" type="button" data-dashboard-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
  </section>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
