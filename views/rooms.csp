<%c++
/* Бронь аудитории (Э7; дизайн v3 — design-drafts/v3/pages/rooms.html и
   rooms-states.html, fe_rebuild шаг 18). Страница НЕ содержит данных:
   каталог аудиторий (GET /v1/rooms?capacity=), сетка слотов дня
   (GET /v1/rooms/{id}/slots?date=) и «Мои брони» (GET
   /v1/room-bookings?upcoming=1) грузит static/js/app.js (только
   createElement/textContent — 02 §6.4).
   Раскладка эталона: .calendar-toolbar (select аудитории «1207 · Корпус Б ·
   24 места» — 50 аудиторий чипами тяжелы; вместимость; дата брони), под
   ним подпись «корпус · мест · оборудование» и ссылка «На карте»
   (/map?q=<номер>); .room-layout — сетка слотов слева, итог
   .booking-summary справа (sticky на ≥1024px — правило app.css).
   Поток брони — три шага 03 §4.9.5: тап свободного слота только выбирает
   его, POST /v1/rooms/{id}/bookings — по primary итога. Свой слот (mine)
   — кнопка: тап открывает danger-диалог отмены (бронь находится в «Моих
   бронях» по room_id + starts_at), как в эталоне. Состояния — по
   rooms-states.html: скелетон, пусто «На эту дату слотов нет» с
   «Выбрать аудиторию», ошибка с «Повторить», офлайн — баннер каркаса и
   data-network-action на кнопках подтверждения. Все строки — словарь
   rooms.* ×3 (5.18). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js подключает страница
     (defer; htmx на этом экране не используется). -->
<script defer src="/static/js/app.js"></script>
<body data-page="rooms">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <a class="back" href="/schedule"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << @@.get<std::string>("t.common.back"); %></a>
      <h1><%c++ $$ << @@.get<std::string>("t.rooms.title"); %></h1>
    </div>
  </div>

  <!-- Панель выбора (эталон: .calendar-toolbar «Аудитория» + «Дата брони»).
       Опции select строит app.js из GET /v1/rooms; ?capacity= — фильтр
       «вместимость не меньше» (02 §5.2). -->
  <div class="calendar-toolbar">
    <div class="rooms-room-field">
      <label for="rooms-room"><%c++ $$ << @@.get<std::string>("t.rooms.room"); %></label>
      <select id="rooms-room" data-room-select disabled></select>
    </div>
    <div class="rooms-cap-field">
      <label for="rooms-capacity"><%c++ $$ << @@.get<std::string>("t.rooms.capacity"); %></label>
      <select id="rooms-capacity" data-capacity-filter>
        <option value=""><%c++ $$ << @@.get<std::string>("t.rooms.capAny"); %></option>
        <option value="20" data-cap-n="20"></option>
        <option value="30" data-cap-n="30"></option>
        <option value="50" data-cap-n="50"></option>
      </select>
    </div>
    <div class="rooms-date-field">
      <label for="slots-date"><%c++ $$ << @@.get<std::string>("t.rooms.date"); %></label>
      <input type="date" id="slots-date" data-slots-date>
    </div>
  </div>
  <p class="small muted rooms-room-line" data-room-meta hidden>
    <span data-room-meta-text></span>
    <a href="/map" data-room-map><%c++ $$ << @@.get<std::string>("t.rooms.onMap"); %></a>
  </p>
  <div data-rooms-loading aria-busy="true" aria-label="<%c++ $$ << @@.get<std::string>("t.common.loading"); %>">
    <div class="skeleton title"></div>
    <div class="skeleton block"></div>
  </div>
  <section class="section flow" data-rooms-error hidden role="alert">
    <h3><%c++ $$ << @@.get<std::string>("t.rooms.errorCatalog"); %></h3>
    <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
    <button class="button" type="button" data-rooms-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
  </section>
  <p class="notice" data-rooms-none hidden><%c++ $$ << @@.get<std::string>("t.rooms.noRooms"); %></p>

  <!-- .room-layout эталона: слоты слева, итог справа (sticky ≥1024px) -->
  <div class="room-layout" data-slots-section hidden>
    <div>
      <div class="section-title">
        <h2 id="slots-title"><%c++ $$ << @@.get<std::string>("t.rooms.slotsTitle"); %></h2>
        <span class="caption"><%c++ $$ << @@.get<std::string>("t.rooms.slotLen"); %></span>
      </div>
      <div class="room-grid" data-slots-loading aria-busy="true" aria-label="<%c++ $$ << @@.get<std::string>("t.common.loading"); %>" hidden>
        <div class="skeleton slot"></div>
        <div class="skeleton slot"></div>
        <div class="skeleton slot"></div>
        <div class="skeleton slot"></div>
      </div>
      <section class="section flow" data-slots-error hidden role="alert">
        <h3><%c++ $$ << @@.get<std::string>("t.rooms.errorSlots"); %></h3>
        <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
        <button class="button" type="button" data-slots-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
      </section>
      <div class="empty" data-slots-empty hidden>
        <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18m-5.5 2.5-5 5m0-5 5 5"/></svg></div>
        <h2><%c++ $$ << @@.get<std::string>("t.rooms.emptyTitle"); %></h2>
        <p><%c++ $$ << @@.get<std::string>("t.rooms.emptyText"); %></p>
        <button class="button" type="button" data-focus-room><%c++ $$ << @@.get<std::string>("t.rooms.pickRoom"); %></button>
      </div>
      <p class="notice danger" data-slots-warn role="alert" hidden></p>
      <div class="room-grid" data-slots-grid aria-labelledby="slots-title" hidden></div>
    </div>
    <!-- Итог выбранного слота (эталон .booking-summary #booking-*) -->
    <div class="booking-summary flow" data-booking-card>
      <p class="overline"><%c++ $$ << @@.get<std::string>("t.rooms.slotMine"); %></p>
      <h3 data-booking-room></h3>
      <p class="small muted" data-booking-meta></p>
      <p class="small" data-booking-choice></p>
      <p class="caption booking-hint"><%c++ $$ << @@.get<std::string>("t.rooms.hint"); %></p>
      <p class="notice success" data-booking-done role="status" hidden></p>
      <button class="button primary full" type="button" data-booking-confirm data-network-action data-offline-label="<%c++ $$ << @@.get<std::string>("t.offline.needed"); %>" disabled><%c++ $$ << @@.get<std::string>("t.rooms.pickSlot"); %></button>
      <p class="caption"><%c++ $$ << @@.get<std::string>("t.rooms.checkBefore"); %></p>
    </div>
  </div>

  <!-- «Мои брони» (эталон #my-bookings: .list-row + «Отменить») -->
  <section class="section" aria-labelledby="bookings-title">
    <div class="section-title">
      <h2 id="bookings-title" tabindex="-1"><%c++ $$ << @@.get<std::string>("t.rooms.myTitle"); %></h2>
      <span class="caption" data-bookings-count></span>
    </div>
    <div data-bookings-loading aria-busy="true" aria-label="<%c++ $$ << @@.get<std::string>("t.common.loading"); %>" hidden>
      <div class="skeleton card"></div>
      <div class="skeleton card"></div>
    </div>
    <section class="section flow" data-bookings-error hidden role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.rooms.errorMy"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
      <button class="button" type="button" data-bookings-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>
    <div class="empty" data-bookings-empty hidden>
      <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg></div>
      <h2><%c++ $$ << @@.get<std::string>("t.rooms.myEmptyTitle"); %></h2>
      <p><%c++ $$ << @@.get<std::string>("t.rooms.myEmptyText"); %></p>
    </div>
    <p class="notice danger" data-bookings-warn role="alert" hidden></p>
    <div data-bookings-list hidden></div>
  </section>

  <!-- Danger-диалог отмены (эталон #cancel-dialog; 03 §2.8/§6.4) -->
  <dialog id="cancel-booking-dialog" class="lesson-sheet" aria-labelledby="cancel-booking-title">
    <h2 id="cancel-booking-title"><%c++ $$ << @@.get<std::string>("t.rooms.cancelTitle"); %></h2>
    <p data-cancel-booking-desc></p>
    <p><%c++ $$ << @@.get<std::string>("t.rooms.cancelNote"); %></p>
    <div class="actions">
      <button class="button" type="button" data-cancel-booking-close><%c++ $$ << @@.get<std::string>("t.rooms.keep"); %></button>
      <button class="button danger-button" type="button" data-cancel-booking-confirm data-network-action><%c++ $$ << @@.get<std::string>("t.rooms.cancelConfirm"); %></button>
    </div>
  </dialog>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
