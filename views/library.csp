<%c++
/* Библиотека (5.12; дизайн v3 — design-drafts/v3/pages/library.html,
   fe_rebuild шаг 19). Страница статична: филиалы (GET /v1/library/branches),
   каталог (GET /v1/library/items?q=&branch_id=&available=1) и читательский
   билет (GET /v1/library/my-card, 404 — билета нет) грузит static/js/app.js
   (только createElement/textContent — 02 §6.4).
   Раскладка эталона: поиск .field, чипы филиалов (aria-pressed), строка
   .enh-toolbar — чекбокс «Только в наличии» (.enh-check, available=1) и
   счётчик «Найдено: N из M» (role=status; M — ответ без фильтров);
   строки .book-row: обложка-иконка, название, «автор · вид · филиал»,
   бейдж «Свободно N из M», «зал · корпус», details «Где и как получить»
   (место из items, номер билета из my-card) с «Показать корпус» →
   /map?building=<building_id филиала>. Бронь книг и «Ваши книги» эталона
   (localStorage) не переносятся — API нет. Состояния (03 §5): скелетон
   при ответе > 300 мс, пусто, ошибка с «Повторить», офлайн — баннер
   каркаса. Строки — словарь library.* ×3 (5.18). */
%>
<%view head %>
<!-- Каркасный head.csp подключает только CSS: app.js подключает страница
     (defer; htmx на этом экране не используется). -->
<script defer src="/static/js/app.js"></script>
<body data-page="library">
<%view topbar %>
<main id="main" class="shell">
  <div class="page-heading">
    <div>
      <a class="back" href="/profile"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg> <%c++ $$ << @@.get<std::string>("t.common.back"); %></a>
      <h1><%c++ $$ << @@.get<std::string>("t.campus.library"); %></h1>
      <p><%c++ $$ << @@.get<std::string>("t.library.subtitle"); %></p>
    </div>
  </div>
  <div class="content-narrow">

    <!-- Поиск (эталон: .field + type=search) -->
    <div class="field">
      <label for="library-q"><%c++ $$ << @@.get<std::string>("t.library.searchLabel"); %></label>
      <input id="library-q" type="search" placeholder="<%c++ $$ << @@.get<std::string>("t.library.searchPh"); %>" data-library-q autocomplete="off">
    </div>

    <!-- Чипы филиалов: «Все филиалы» + по одному (строит app.js) -->
    <div class="chips" role="group" aria-label="<%c++ $$ << @@.get<std::string>("t.library.branches"); %>" data-library-branches>
      <button class="chip" type="button" data-branch-id="" aria-pressed="true"><%c++ $$ << @@.get<std::string>("t.library.allBranches"); %></button>
    </div>

    <!-- Эталон .enh-toolbar: чекбокс «Только в наличии» + счётчик -->
    <div class="enh-toolbar">
      <label class="enh-check"><input id="library-available" type="checkbox" data-library-available><%c++ $$ << @@.get<std::string>("t.library.onlyAvailable"); %></label>
      <p class="caption" role="status" aria-live="polite" data-library-count></p>
    </div>

    <!-- Скелетон (03 §5.1): показывается app.js ТОЛЬКО при ответе > 300 мс -->
    <div class="stack" data-library-loading hidden aria-busy="true" aria-label="<%c++ $$ << @@.get<std::string>("t.library.searching"); %>">
      <div class="skeleton card"></div>
      <div class="skeleton card"></div>
      <div class="skeleton card"></div>
    </div>

    <!-- Пусто (эталон #books-empty) -->
    <div class="empty" data-library-empty hidden>
      <div class="empty-icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3M8.5 11h5"/></svg></div>
      <h2><%c++ $$ << @@.get<std::string>("t.library.emptyTitle"); %></h2>
      <p><%c++ $$ << @@.get<std::string>("t.library.emptyText"); %></p>
    </div>

    <!-- Ошибка (03 §5.3): «Повторить» реально перезапрашивает -->
    <section class="section flow" data-library-error hidden role="alert">
      <h3><%c++ $$ << @@.get<std::string>("t.error.loadCatalog"); %></h3>
      <p class="muted"><%c++ $$ << @@.get<std::string>("t.error.checkInternet"); %></p>
      <button class="button" type="button" data-library-retry><%c++ $$ << @@.get<std::string>("t.common.retry"); %></button>
    </section>

    <!-- Строки книг (.book-row эталона) строит app.js -->
    <div data-library-results hidden>
      <div data-library-list></div>
    </div>

  </div>
</main>
<%view tabbar %>
<%view footer %>
</body>
</html>
